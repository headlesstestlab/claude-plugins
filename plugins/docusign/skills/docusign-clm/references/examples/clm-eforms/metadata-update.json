{
  "id": "metadata-update",
  "name": "Agreement Metadata Update",
  "description": "Correct or complete the data on an agreement already in CLM. As an Edit Form task you update this same record, so the history stays in one place.",
  "submitFolder": "eForms/Agreement Metadata Update/Submitted",
  "allowUpdates": true,
  "styles": [
    "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  ],
  "sections": [
    {
      "title": "Agreement",
      "fields": [
        {
          "kind": "attribute",
          "attribute": "Agreement.Agreement Id",
          "label": "Agreement ID",
          "help": "Filled by CLM; read only.",
          "readOnly": true
        },
        {
          "kind": "attribute",
          "attribute": "Agreement.Status",
          "label": "Status",
          "required": true
        },
        {
          "kind": "attribute",
          "attribute": "Document.Document Type",
          "label": "Document type"
        },
        {
          "kind": "attribute",
          "attribute": "External Party.Business Name",
          "label": "Counterparty legal name"
        }
      ]
    },
    {
      "title": "Key terms",
      "fields": [
        {
          "kind": "note",
          "text": "Change only what the signed agreement says; the history keeps every earlier value."
        },
        {
          "kind": "attribute",
          "attribute": "Amendment.Expiration Date",
          "label": "Expiration date"
        },
        {
          "kind": "attribute",
          "attribute": "Amendment.# of Amendments",
          "label": "Number of amendments"
        },
        {
          "kind": "attribute",
          "attribute": "Terms.Governing Law",
          "label": "Governing law"
        },
        {
          "kind": "attribute",
          "attribute": "Terms.Limitation of Liability",
          "label": "Limitation of liability"
        }
      ]
    },
    {
      "title": "Ownership and handling",
      "fields": [
        {
          "kind": "attribute",
          "attribute": "Document.Document Owner",
          "label": "Agreement owner"
        },
        {
          "kind": "attribute",
          "attribute": "Document.Information Classification",
          "label": "Information classification"
        }
      ]
    },
    {
      "title": "Change request",
      "help": "Saved with this form only. The parts above hold the CLM attributes.",
      "fields": [
        {
          "kind": "select",
          "id": "fxChangeType",
          "label": "Change type",
          "options": [
            "Correction",
            "Missing data",
            "Reclassification"
          ]
        },
        {
          "kind": "text",
          "id": "fxReason",
          "label": "Reason for the update"
        },
        {
          "kind": "date",
          "id": "fxEffective",
          "label": "Effective date of the change"
        },
        {
          "kind": "select",
          "id": "fxUrgent",
          "label": "Urgent?",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "kind": "checkbox",
          "id": "fxAck",
          "label": "Checked against the signed copy",
          "value": "true"
        },
        {
          "kind": "textarea",
          "id": "fxNotes",
          "label": "Notes"
        }
      ]
    }
  ],
  "keepIds": [
    "fxChangeType",
    "fxReason",
    "fxEffective",
    "fxUrgent",
    "fxAck",
    "fxNotes"
  ],
  "attributeIds": {
    "Agreement.Agreement Id": "8e425376-6fb3-f111-93b3-e8e4a5d525fb",
