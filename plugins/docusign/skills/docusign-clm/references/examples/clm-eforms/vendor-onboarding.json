    "Oblligations.Name": "36435376-6fb3-f111-93b3-e8e4a5d525fb",
    "Oblligations.Category": "37435376-6fb3-f111-93b3-e8e4a5d525fb",
    "Oblligations.Description": "51435376-6fb3-f111-93b3-e8e4a5d525fb",
    "Oblligations.Due Date": "58435376-6fb3-f111-93b3-e8e4a5d525fb"
  }
}
