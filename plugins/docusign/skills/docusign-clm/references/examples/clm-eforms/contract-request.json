{
  "id": "contract-request",
  "name": "Contract Request",
  "description": "Ask Legal for a new agreement, a renewal or an amendment. Answer what you know; Legal asks for the rest in a follow-up task. About 3 minutes.",
  "submitFolder": "eForms/Contract Request/Submitted",
  "sections": [
    {
      "title": "1. Your request",
      "fields": [
        {
          "kind": "select",
          "id": "crRequestType",
          "label": "Request type",
          "required": true,
          "options": [
            "New agreement",
            "Renewal",
            "Amendment"
          ]
        },
        {
          "kind": "select",
          "id": "crAgreementType",
          "label": "Agreement type",
          "options": [
            "Master Services Agreement",
            "Statement of Work",
            "Order Form",
            "NDA",
            "Data Processing Agreement",
            "Other"
          ]
        },
        {
          "kind": "attribute",
          "attribute": "Internal Entity.Entity Business Unit",
          "label": "Your business unit",
          "required": true
        },
        {
          "kind": "attribute",
          "attribute": "Internal Entity.Entity Name",
          "label": "Contracting entity",
          "required": true,
          "help": "The Fontara company that signs. Ask Finance if you are not sure."
        },
        {
          "kind": "attribute",
          "attribute": "Document.Document Owner",
          "label": "Requester",
          "help": "You, or the person Legal should contact."
        },
        {
          "kind": "textarea",
          "id": "crPurpose",
          "label": "Business purpose",
          "help": "One or two sentences for the reviewer: what is bought or sold, and why now."
        }
      ]
    },
    {
      "title": "2. Counterparty",
      "fields": [
        {
          "kind": "attribute",
          "attribute": "External Party.Business Name",
          "label": "Counterparty legal name",
          "required": true,
          "placeholder": "As on their registration"
        },
        {
          "kind": "attribute",
          "attribute": "External Party.Party Type",
          "label": "Relationship"
        },
        {
          "kind": "attribute",
          "attribute": "External Party.Contact Name",
          "label": "Counterparty contact",
          "placeholder": "Full name"
        },
        {
          "kind": "attribute",
          "attribute": "External Party.Contact Email",
          "label": "Contact email",
          "placeholder": "Their work email"
        },
        {
          "kind": "attribute",
          "attribute": "External Party.Country",
          "label": "Country"
        }
      ]
    },
    {
      "title": "3. Value and dates",
      "fields": [
        {
          "kind": "number",
          "id": "crValue",
          "label": "Estimated value (USD)",
          "help": "Whole term. Above $250,000 adds a Finance approval."
        },
        {
          "kind": "date",
          "id": "crEffective",
          "label": "Target effective date"
        },
        {
          "kind": "attribute",
          "attribute": "Amendment.Expiration Date",
          "label": "Expected end date",
          "placeholder": "M/D/YYYY"
        },
        {
          "kind": "attribute",
          "attribute": "Terms.Governing Law",
          "label": "Governing law"
        }
      ]
    },
    {
      "title": "4. Third-party paper",
      "fields": [
        {
          "kind": "attribute",
          "attribute": "Agreement.Third Party",
          "label": "On the counterparty's paper?",
          "help": "Yes opens the upload. Legal reviews their draft instead of starting from a Fontara template."
        },
        {
          "kind": "attachment",
          "label": "Their draft",
          "count": 1,
          "required": true,
          "help": "Required when the paper is theirs.",
          "showIf": {
            "field": "Agreement.Third Party",
            "equals": "Yes"
          }
        }
      ]
    }
  ],
  "attributeIds": {
    "Internal Entity.Entity Business Unit": "df425376-6fb3-f111-93b3-e8e4a5d525fb",
    "Internal Entity.Entity Name": "d3425376-6fb3-f111-93b3-e8e4a5d525fb",
    "Document.Document Owner": "af425376-6fb3-f111-93b3-e8e4a5d525fb",
    "External Party.Business Name": "c0425376-6fb3-f111-93b3-e8e4a5d525fb",
    "External Party.Party Type": "c5425376-6fb3-f111-93b3-e8e4a5d525fb",
    "External Party.Contact Name": "c7425376-6fb3-f111-93b3-e8e4a5d525fb",
    "External Party.Contact Email": "c8425376-6fb3-f111-93b3-e8e4a5d525fb",
    "External Party.Country": "d0425376-6fb3-f111-93b3-e8e4a5d525fb",
    "Amendment.Expiration Date": "99425376-6fb3-f111-93b3-e8e4a5d525fb",
    "Terms.Governing Law": "87435376-6fb3-f111-93b3-e8e4a5d525fb",
    "Agreement.Third Party": "8b425376-6fb3-f111-93b3-e8e4a5d525fb"
  }
}
