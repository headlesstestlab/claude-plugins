{
  "id": "fontara-generated-order-approval",
  "name": "Generated Order Approval",
  "description": "Launched by the Fontara Platform Order Form document generation configuration. It files the generated order's attributes (Agreement Profile: Order Form, Sales, the Fontara entity, the customer, the currency; Contract Process: Draft, the order number), then runs the same Escalation-matrix approvals (the child workflow Escalation matrix approvals), negotiation and signature as Contract Request to Execution, reading the routing answers from the form (Params ▸ TemplateFieldData). The customer signs first, then Fontara's signer; when both have signed, Status is Executed. The generated document is renamed '<customer> Order Form <order number>.docx' and moved to Contracts/Sales. When a counterparty redline changes a term the matrix routes on, the Deal Desk picks the term (Terms changed: route again) and the contract goes back to In Review and through the approvals again. A step that fails ends the run as Failed and CLM emails the person who started it. After filing, the run sets CLM's standard agreement attributes from the form (the owner 11-21): Find Party (Customer Legal Name), check-out, Edit CLM Agreement Attributes (Type Order Form, Party, Effective = Order Effective Date, Expiration = effective + term − 1 day, Value = Total Order Value, Payment Duration), cancel the check-out, and Update Document Keywords writes a one-line summary as the document's Description. A party that is not on the site leaves Party empty; a failing step goes on to naming the document, so the deal never stops on it.",
  "variables": [
    {
      "name": "DealValue",
      "type": "number"
    },
    {
      "name": "PayDays",
      "type": "number"
    },
    "Side",
    "Verdict",
    "CoveredByDPA",
    "TouchesData",
    "SignerEmail",
    "SignerName",
    "CompanySignerEmail",
    "CompanySignerName",
    "Changed",
    "ValueOver",
    "Title",
    {
      "name": "MatrixIn",
      "type": "xml",
      "schema": "<Params><Documents><Document><Id/><Name/></Document></Documents><Title/><Side/><DealValue/><PayDays/><Verdict/><CoveredByDPA/><TouchesData/><ValueOver/></Params>"
    },
    {
      "name": "MatrixResult",
      "type": "text",
      "writableByChild": true
    },
    "AgreementStart",
    "AgreementEnd",
    "Summary",
    {
      "name": "Party",
      "type": "xml",
      "schema": "<Parties><CLMPartyData><CLMPartyId/><ExternalId/><Name/><BusinessContactName/><BusinessType/><Source/></CLMPartyData></Parties>"
    },
    {
      "name": "FilingFolder",
      "type": "folder"
    }
  ],
  "paramsSchema": "<Params><Documents><Document><Id/><Name/></Document></Documents><TemplateFieldData><Customer_Legal_Name/><Legal_Entity/><Order_Number/><Total_Order_Value/><Payment_Terms_Days/><Covered_by_an_Existing_DPA/><Triage_Verdict/><Side/><Customer_Signer_Name/><Customer_Signer_Email/><Company_Signer_Name/><Company_Signer_Email/><Customer_Termination_for_Convenience/></TemplateFieldData></Params>",
  "taskGroupsByName": true,
  "steps": [
    {
      "id": "intake",
      "name": "Read the request",
      "kind": "setVariable",
      "set": {
        "Side": "<%#XmlVariables.Params.TemplateFieldData.Side%>",
        "DealValue": "<%#XmlVariables.Params.TemplateFieldData.Total_Order_Value%>",
        "PayDays": "<%#XmlVariables.Params.TemplateFieldData.Payment_Terms_Days%>",
        "Verdict": "<%#XmlVariables.Params.TemplateFieldData.Triage_Verdict%>",
        "CoveredByDPA": "<%#XmlVariables.Params.TemplateFieldData.Covered_by_an_Existing_DPA%>",
        "TouchesData": "No",
        "SignerEmail": "<%#XmlVariables.Params.TemplateFieldData.Customer_Signer_Email%>",
        "SignerName": "<%#XmlVariables.Params.TemplateFieldData.Customer_Signer_Name%>",
        "CompanySignerEmail": "<%#XmlVariables.Params.TemplateFieldData.Company_Signer_Email%>",
        "CompanySignerName": "<%#XmlVariables.Params.TemplateFieldData.Company_Signer_Name%>",
        "Title": "<%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%> Order Form <%#XmlVariables.Params.TemplateFieldData.Order_Number%>"
      },
      "next": "profile"
    },
    {
      "id": "profile",
      "name": "File the order's attributes",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Agreement Profile.Agreement Type",
          "value": "Order Form"
        },
        {
          "attribute": "Agreement Profile.Line of Business",
          "value": "Sales"
        },
        {
          "attribute": "Agreement Profile.Department",
          "value": "Sales"
        },
        {
          "attribute": "Agreement Profile.Legal Entity",
          "value": "<%#XmlVariables.Params.TemplateFieldData.Legal_Entity%>"
        },
        {
          "attribute": "Agreement Profile.Counterparty",
          "value": "<%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%>"
        },
        {
          "attribute": "Agreement Profile.Currency",
          "value": "<%#XmlVariables.Params.TemplateFieldData.Currency%>"
        },
        {
          "attribute": "Contract Process.Contract Number",
          "value": "<%#XmlVariables.Params.TemplateFieldData.Order_Number%>"
        },
        {
          "attribute": "Contract Process.Status",
          "value": "Draft"
        },
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Not Started"
        }
      ],
      "on": {
        "success": "stdDates"
      }
    },
    {
      "id": "stdDates",
      "name": "Work out the agreement dates",
      "kind": "setVariable",
      "set": {
        "AgreementStart": {
          "code": "return Convert.ToString(GetVariableValue(\"Params.Params.TemplateFieldData.Order_Effective_Date_unformatted\")).Substring(0, 10);"
        },
        "AgreementEnd": {
          "code": "var start = DateTime.Parse(Convert.ToString(GetVariableValue(\"Params.Params.TemplateFieldData.Order_Effective_Date_unformatted\")).Substring(0, 10)); return start.AddMonths(Convert.ToInt32(Convert.ToString(GetVariableValue(\"Params.Params.TemplateFieldData.Term_in_Months_unformatted\")))).AddDays(-1).ToString(\"yyyy-MM-dd\");"
        },
        "Summary": "Order Form <%#XmlVariables.Params.TemplateFieldData.Order_Number%>: <%#XmlVariables.Params.TemplateFieldData.Legal_Entity%> with <%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%>, <%#XmlVariables.Params.TemplateFieldData.Users%> users for <%#XmlVariables.Params.TemplateFieldData.Term_in_Months%> months from <%#XmlVariables.Params.TemplateFieldData.Order_Effective_Date%>, <%#XmlVariables.Params.TemplateFieldData.Currency%> <%#XmlVariables.Params.TemplateFieldData.Total_Order_Value%>, Net <%#XmlVariables.Params.TemplateFieldData.Payment_Terms_Days%>. Under the <%#XmlVariables.Params.TemplateFieldData.Master_Agreement%>"
      },
      "next": "stdParty"
    },
    {
      "id": "stdParty",
      "name": "Find the party",
      "kind": "findParty",
      "partyName": "<%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%>",
      "output": "Party",
      "on": {
        "match": "stdLock",
        "noMatch": "stdLock",
        "failure": "stdLock"
      }
    },
    {
      "id": "stdLock",
      "name": "Check out",
      "kind": "checkOutDocument",
      "user": "submitter",
      "on": {
        "success": "stdAttributes",
        "failure": "stdDescribe"
      }
    },
    {
      "id": "stdAttributes",
      "name": "Set the CLM agreement attributes",
      "kind": "editClmAgreementAttributes",
      "set": {
        "partyId": "<%#XmlVariables.Party.Parties.CLMPartyData.CLMPartyId%>",
        "documentType": "Order Form",
        "effectiveDate": "<%#Variable.AgreementStart%>",
        "expirationDate": "<%#Variable.AgreementEnd%>",
        "totalContractValue": "<%#XmlVariables.Params.TemplateFieldData.Total_Order_Value_unformatted%>",
        "paymentDurationCount": "<%#XmlVariables.Params.TemplateFieldData.Payment_Terms_Days%>",
        "paymentDurationUnit": "Days",
        "paymentTerms": "Yes",
        "paymentLateFees": "Yes"
      },
      "on": {
        "success": "stdConvenience",
        "failure": "stdUnlock"
      }
    },
    {
      "id": "stdConvenience",
      "name": "Termination for convenience in the order?",
      "kind": "decision",
      "branches": [
        {
          "label": "Yes",
          "when": {
            "var": "Params.TemplateFieldData.Customer_Termination_for_Convenience",
            "op": "equals",
            "value": "Yes"
          },
          "to": "stdConvenienceYes"
        }
      ],
      "else": {
        "label": "No",
        "to": "stdUnlock"
      }
    },
    {
      "id": "stdConvenienceYes",
      "name": "Termination Convenience: Yes",
      "kind": "editClmAgreementAttributes",
      "set": {
        "terminationConvenience": "Yes"
      },
      "on": {
        "success": "stdUnlock",
        "failure": "stdUnlock"
      }
    },
    {
      "id": "stdUnlock",
      "name": "Cancel the check out",
      "kind": "checkOutDocumentCancellation",
      "user": "submitter",
      "on": {
        "success": "stdDescribe",
        "failure": "stdDescribe"
      }
    },
    {
      "id": "stdDescribe",
      "name": "Describe the agreement",
      "kind": "updateDocumentKeywords",
      "keywords": "<%#Variable.Summary%>",
      "on": {
        "success": "rename",
        "failure": "rename"
      }
    },
    {
      "id": "rename",
      "name": "Name the document",
      "kind": "renameDocument",
      "newName": "<%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%> Order Form <%#XmlVariables.Params.TemplateFieldData.Order_Number%>.docx",
      "on": {
        "success": "fileFolder"
      }
    },
    {
      "id": "fileFolder",
      "name": "Find the department folder",
      "kind": "findFolder",
      "folder": {
        "path": "/Contracts/Sales"
      },
      "output": "FilingFolder",
      "on": {
        "success": "file",
        "failure": "file"
      }
    },
    {
      "id": "file",
      "name": "File it in the department folder",
      "kind": "copyOrMoveDocument",
      "action": "move",
      "folder": {
        "var": "FilingFolder"
      },
      "on": {
        "success": "inReview"
      }
    },
    {
      "id": "inReview",
      "name": "Mark In Review",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "In Review"
        },
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Pending"
        }
      ],
      "on": {
        "success": "handoff"
      }
    },
    {
      "id": "handoff",
      "name": "Hand the deal to the matrix",
      "kind": "prefillXml",
      "output": "MatrixIn",
      "root": "Params",
      "copyDocument": true,
      "fields": {
        "Title": "Title",
        "Side": "Side",
        "DealValue": "DealValue",
        "PayDays": "PayDays",
        "Verdict": "Verdict",
        "CoveredByDPA": "CoveredByDPA",
        "TouchesData": "TouchesData",
        "ValueOver": "ValueOver"
      },
      "next": "matrix"
    },
    {
      "id": "matrix",
      "name": "Escalation matrix approvals",
      "kind": "childWorkflow",
      "workflow": "Escalation matrix approvals",
      "params": "MatrixIn",
      "wait": true,
      "description": "Runs Escalation matrix approvals: rules 1 to 6 in order, each matching rule adds an approver; it sets MatrixResult to Approved or Rejected.",
      "on": {
        "success": "matrixSaid"
      }
    },
    {
      "id": "matrixSaid",
      "name": "Approved by the matrix?",
      "kind": "decision",
      "branches": [
        {
          "label": "Approved",
          "when": {
            "var": "MatrixResult",
            "op": "equals",
            "value": "Approved"
          },
          "to": "approved"
        }
      ],
      "else": {
        "label": "Rejected",
        "to": "rejected"
      }
    },
    {
      "id": "approved",
      "name": "Approved: mark In Negotiation",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Approved"
        },
        {
          "attribute": "Contract Process.Status",
          "value": "In Negotiation"
        }
      ],
      "on": {
        "success": "negotiate"
      }
    },
    {
      "id": "negotiate",
      "name": "Deal desk: edit, re-route or send?",
      "kind": "choice",
      "assignee": {
        "taskGroup": "Deal Desk"
      },
      "displayName": "Negotiate: <%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%> Order Form <%#XmlVariables.Params.TemplateFieldData.Order_Number%>",
      "stage": "Negotiation",
      "subject": "Negotiate or send for signature",
      "instructions": "Apply the counterparty's redline from the clause library's approved alternatives (Edit the contract). If the redline changes a term the Escalation matrix routes on, choose Terms changed: route again. Send it for signature when both sides agree.",
      "comments": "Yes",
      "options": [
        {
          "label": "Edit the contract",
          "to": "edit"
        },
        {
          "label": "Terms changed: route again",
          "to": "changed"
        },
        {
          "label": "Send for signature",
          "to": "send"
        }
      ]
    },
    {
      "id": "edit",
      "name": "Edit the redline",
      "kind": "editDocument",
      "assignee": {
        "taskGroup": "Deal Desk"
      },
      "stage": "Negotiation",
      "instructions": "Upload the new version (or edit it online), then complete the task.",
      "comments": "Yes",
      "on": {
        "completed": "negotiate"
      }
    },
    {
      "id": "changed",
      "name": "Which term changed?",
      "kind": "routing",
      "assignee": {
        "taskGroup": "Deal Desk"
      },
      "options": [
        "Legal terms now non-standard (red)",
        "Legal terms now at the acceptable position (yellow)",
        "Value now over $1M",
        "Payment terms now Net 90",
        "New personal data no DPA covers",
        "Vendor will now touch Fontara systems or data"
      ],
      "output": "Changed",
      "displayName": "Route again: <%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%> Order Form <%#XmlVariables.Params.TemplateFieldData.Order_Number%>",
      "stage": "Negotiation",
      "subject": "Which term did the redline change?",
      "instructions": "Pick the term the counterparty's redline changed. The contract goes back through the Escalation matrix's approvals with it.",
      "comments": "Yes",
      "on": {
        "success": "applyChange"
      }
    },
    {
      "id": "applyChange",
      "name": "Apply the changed term",
      "kind": "setVariable",
      "set": {
        "Verdict": {
          "map": "Changed",
          "cases": {
            "Legal terms now non-standard (red)": "Red",
            "Legal terms now at the acceptable position (yellow)": "Yellow"
          }
        },
        "ValueOver": {
          "map": "Changed",
          "cases": {
            "Value now over $1M": "Yes"
          }
        },
        "PayDays": {
          "map": "Changed",
          "cases": {
            "Payment terms now Net 90": "90"
          }
        },
        "CoveredByDPA": {
          "map": "Changed",
          "cases": {
            "New personal data no DPA covers": "No"
          }
        },
        "TouchesData": {
          "map": "Changed",
          "cases": {
            "Vendor will now touch Fontara systems or data": "Yes"
          }
        }
      },
      "next": "reroute"
    },
    {
      "id": "reroute",
      "name": "Back to In Review",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "In Review"
        },
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Pending"
        }
      ],
      "on": {
        "success": "handoff"
      }
    },
    {
      "id": "send",
      "name": "Send for signature",
      "kind": "reviewAndSendForSignature",
      "assignee": "submitter",
      "expirationDays": 120,
      "recipients": [
        {
          "var": "SignerEmail",
          "role": "Signer 1",
          "name": {
            "var": "SignerName"
          }
        },
        {
          "var": "CompanySignerEmail",
          "role": "Signer 2",
          "name": {
            "var": "CompanySignerName"
          }
        }
      ],
      "subject": "Please sign: <%#XmlVariables.Params.TemplateFieldData.Customer_Legal_Name%> Order Form <%#XmlVariables.Params.TemplateFieldData.Order_Number%>",
      "message": "Fontara has approved this agreement. Please sign it.",
      "instructions": "The customer signs first, then Fontara's signer (signing authority from the Escalation matrix). The person who started the request checks both and send.",
      "stage": "Signature",
      "on": {
        "sent": "outForSignature",
        "canceled": "negotiate"
      }
    },
    {
      "id": "outForSignature",
      "name": "Mark Out for Signature",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "Out for Signature"
        }
      ],
      "on": {
        "success": "wait"
      }
    },
    {
      "id": "wait",
      "name": "Wait for signature",
      "kind": "waitForSignature",
      "on": {
        "signed": "executed",
        "rejected": "backToNegotiation",
        "cancelled": "backToNegotiation",
        "timedOut": "backToNegotiation"
      }
    },
    {
      "id": "backToNegotiation",
      "name": "Back to In Negotiation",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "In Negotiation"
        }
      ],
      "on": {
        "success": "negotiate"
      }
    },
    {
      "id": "executed",
      "name": "Mark Executed",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "Executed"
        }
      ],
      "on": {
        "success": "logDone"
      }
    },
    {
      "id": "logDone",
      "name": "Log executed",
      "kind": "logger",
      "message": "Signed: Status set to Executed",
      "next": "finish"
    },
    {
      "id": "rejected",
      "name": "Rejected: back to Draft",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Rejected"
        },
        {
          "attribute": "Contract Process.Status",
          "value": "Draft"
        }
      ],
      "on": {
        "success": "logRejected"
      }
    },
    {
      "id": "logRejected",
      "name": "Log rejected",
      "kind": "logger",
      "message": "An approver rejected the contract: Status back to Draft",
      "next": "finish"
    },
    {
      "id": "finish",
      "name": "Finish",
      "kind": "finish"
    }
  ],
  "errorNotify": [
    "submitter"
  ]
}
