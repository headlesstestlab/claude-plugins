      "on": {
        "completed": "edit",
        "failure": "finish"
      }
    },
    {
      "id": "edit",
      "name": "Correct the vendor form",
      "kind": "fullPageEditForm",
      "assignee": "submitter",
      "documents": {
        "var": "Filled"
      },
      "on": {
        "completed": "finish",
        "failure": "finish"
      }
    },
    {
      "id": "finish",
      "kind": "finish"
    }
  ]
