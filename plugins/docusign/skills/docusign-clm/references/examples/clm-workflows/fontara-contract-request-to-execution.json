{
  "id": "fontara-contract-request-to-execution",
  "name": "Contract Request to Execution",
  "description": "Fontara's contract lifecycle on its CLM account: the contract is marked In Review, then Escalation matrix approvals (a child workflow, shared with the other Fontara approval workflows) routes it by the Escalation matrix (every matching rule adds an approver, each a task group): a red triage verdict to Legal, a yellow one to Legal Operations; sell side over $1M to Sales Leadership and payment terms beyond Net 60 to Finance; buy side to Procurement; no existing DPA to Privacy; a vendor that touches Fontara systems or data to IT and Security. The parent hands the deal's facts and the document to the child and reads back Approved or Rejected (Update Parent Variable). Once approved, the Deal Desk negotiates (edits for counterparty redlines) and sends it for signature; when it is signed the workflow sets Contract Process ▸ Status to Executed. A rejection sets Approval Status to Rejected and the Status back to Draft. When a counterparty redline changes a term the matrix routes on, the Deal Desk picks the term (Terms changed: route again), one step applies it to the deal's facts, and the contract goes back to In Review and through the matrix again. A step that fails ends the run as Failed and CLM emails the person who started it.",
  "variables": [
    {
      "name": "DealValue",
      "type": "number"
    },
    {
      "name": "PayDays",
      "type": "number"
    },
    "Side",
    "Verdict",
    "CoveredByDPA",
    "TouchesData",
    "SignerEmail",
    "SignerName",
    "Changed",
    "ValueOver",
    "Title",
    {
      "name": "MatrixIn",
      "type": "xml",
      "schema": "<Params><Documents><Document><Id/><Name/></Document></Documents><Title/><Side/><DealValue/><PayDays/><Verdict/><CoveredByDPA/><TouchesData/><ValueOver/></Params>"
    },
    {
      "name": "MatrixResult",
      "type": "text",
      "writableByChild": true
    }
  ],
  "paramsSchema": "<Params><Documents><Document><Id/><Name/></Document></Documents><Side/><DealValue/><PaymentTermsDays/><TriageVerdict/><CoveredByDPA/><VendorTouchesData/><SignerEmail/><SignerName/></Params>",
  "steps": [
    {
      "id": "intake",
      "name": "Read the request",
      "kind": "setVariable",
      "set": {
        "Side": "<%#XmlVariables.Params.Side%>",
        "DealValue": "<%#XmlVariables.Params.DealValue%>",
        "PayDays": "<%#XmlVariables.Params.PaymentTermsDays%>",
        "Verdict": "<%#XmlVariables.Params.TriageVerdict%>",
        "CoveredByDPA": "<%#XmlVariables.Params.CoveredByDPA%>",
        "TouchesData": "<%#XmlVariables.Params.VendorTouchesData%>",
        "SignerEmail": "<%#XmlVariables.Params.SignerEmail%>",
        "SignerName": "<%#XmlVariables.Params.SignerName%>",
        "Title": "<%#XmlVariables.Params.Documents.Document.Name%>"
      },
      "next": "inReview"
    },
    {
      "id": "inReview",
      "name": "Mark In Review",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "In Review"
        },
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Pending"
        }
      ],
      "on": {
        "success": "handoff"
      }
    },
    {
      "id": "handoff",
      "name": "Hand the deal to the matrix",
      "kind": "prefillXml",
      "output": "MatrixIn",
      "root": "Params",
      "copyDocument": true,
      "fields": {
        "Title": "Title",
        "Side": "Side",
        "DealValue": "DealValue",
        "PayDays": "PayDays",
        "Verdict": "Verdict",
        "CoveredByDPA": "CoveredByDPA",
        "TouchesData": "TouchesData",
        "ValueOver": "ValueOver"
      },
      "next": "matrix"
    },
    {
      "id": "matrix",
      "name": "Escalation matrix approvals",
      "kind": "childWorkflow",
      "workflow": "Escalation matrix approvals",
      "params": "MatrixIn",
      "wait": true,
      "description": "Runs Escalation matrix approvals: rules 1 to 6 in order, each matching rule adds an approver; it sets MatrixResult to Approved or Rejected.",
      "on": {
        "success": "matrixSaid"
      }
    },
    {
      "id": "matrixSaid",
      "name": "Approved by the matrix?",
      "kind": "decision",
      "branches": [
        {
          "label": "Approved",
          "when": {
            "var": "MatrixResult",
            "op": "equals",
            "value": "Approved"
          },
          "to": "approved"
        }
      ],
      "else": {
        "label": "Rejected",
        "to": "rejected"
      }
    },
    {
      "id": "approved",
      "name": "Approved: mark In Negotiation",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Approved"
        },
        {
          "attribute": "Contract Process.Status",
          "value": "In Negotiation"
        }
      ],
      "on": {
        "success": "negotiate"
      }
    },
    {
      "id": "negotiate",
      "name": "Deal desk: edit, re-route or send?",
      "kind": "choice",
      "assignee": {
        "taskGroup": "Deal Desk"
      },
      "displayName": "Negotiate: <%#XmlVariables.Params.Documents.Document.Name%>",
      "stage": "Negotiation",
      "subject": "Negotiate or send for signature",
      "instructions": "Apply the counterparty's redline from the clause library's approved alternatives (Edit the contract). If the redline changes a term the Escalation matrix routes on, choose Terms changed: route again. Send it for signature when both sides agree.",
      "comments": "Yes",
      "options": [
        {
          "label": "Edit the contract",
          "to": "edit"
        },
        {
          "label": "Terms changed: route again",
          "to": "changed"
        },
        {
          "label": "Send for signature",
          "to": "send"
        }
      ]
    },
    {
      "id": "edit",
      "name": "Edit the redline",
      "kind": "editDocument",
      "assignee": {
        "taskGroup": "Deal Desk"
      },
      "stage": "Negotiation",
      "instructions": "Upload the new version (or edit it online), then complete the task.",
      "comments": "Yes",
      "on": {
        "completed": "negotiate"
      }
    },
    {
      "id": "changed",
      "name": "Which term changed?",
      "kind": "routing",
      "assignee": {
        "taskGroup": "Deal Desk"
      },
      "options": [
        "Legal terms now non-standard (red)",
        "Legal terms now at the acceptable position (yellow)",
        "Value now over $1M",
        "Payment terms now Net 90",
        "New personal data no DPA covers",
        "Vendor will now touch Fontara systems or data"
      ],
      "output": "Changed",
      "displayName": "Route again: <%#XmlVariables.Params.Documents.Document.Name%>",
      "stage": "Negotiation",
      "subject": "Which term did the redline change?",
      "instructions": "Pick the term the counterparty's redline changed. The contract goes back through the Escalation matrix's approvals with it.",
      "comments": "Yes",
      "on": {
        "success": "applyChange"
      }
    },
    {
      "id": "applyChange",
      "name": "Apply the changed term",
      "kind": "setVariable",
      "set": {
        "Verdict": {
          "map": "Changed",
          "cases": {
            "Legal terms now non-standard (red)": "Red",
            "Legal terms now at the acceptable position (yellow)": "Yellow"
          }
        },
        "ValueOver": {
          "map": "Changed",
          "cases": {
            "Value now over $1M": "Yes"
          }
        },
        "PayDays": {
          "map": "Changed",
          "cases": {
            "Payment terms now Net 90": "90"
          }
        },
        "CoveredByDPA": {
          "map": "Changed",
          "cases": {
            "New personal data no DPA covers": "No"
          }
        },
        "TouchesData": {
          "map": "Changed",
          "cases": {
            "Vendor will now touch Fontara systems or data": "Yes"
          }
        }
      },
      "next": "reroute"
    },
    {
      "id": "reroute",
      "name": "Back to In Review",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "In Review"
        },
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Pending"
        }
      ],
      "on": {
        "success": "handoff"
      }
    },
    {
      "id": "send",
      "name": "Send for signature",
      "kind": "reviewAndSendForSignature",
      "assignee": "submitter",
      "recipients": [
        {
          "var": "SignerEmail",
          "role": "Signer 1",
          "name": {
            "var": "SignerName"
          }
        }
      ],
      "subject": "Please sign: <%#XmlVariables.Params.Documents.Document.Name%>",
      "message": "Fontara has approved this agreement. Please sign it.",
      "instructions": "The person who started the request checks the signers (Fontara's signer comes from the Escalation matrix's signing authority) and send.",
      "stage": "Signature",
      "on": {
        "sent": "outForSignature",
        "canceled": "negotiate"
      }
    },
    {
      "id": "outForSignature",
      "name": "Mark Out for Signature",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "Out for Signature"
        }
      ],
      "on": {
        "success": "wait"
      }
    },
    {
      "id": "wait",
      "name": "Wait for signature",
      "kind": "waitForSignature",
      "on": {
        "signed": "executed",
        "rejected": "backToNegotiation",
        "cancelled": "backToNegotiation",
        "timedOut": "backToNegotiation"
      }
    },
    {
      "id": "backToNegotiation",
      "name": "Back to In Negotiation",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "In Negotiation"
        }
      ],
      "on": {
        "success": "negotiate"
      }
    },
    {
      "id": "executed",
      "name": "Mark Executed",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Status",
          "value": "Executed"
        }
      ],
      "on": {
        "success": "logDone"
      }
    },
    {
      "id": "logDone",
      "name": "Log executed",
      "kind": "logger",
      "message": "Signed: Status set to Executed",
      "next": "finish"
    },
    {
      "id": "rejected",
      "name": "Rejected: back to Draft",
      "kind": "updateMetadata",
      "set": [
        {
          "attribute": "Contract Process.Approval Status",
          "value": "Rejected"
        },
        {
          "attribute": "Contract Process.Status",
          "value": "Draft"
        }
      ],
      "on": {
        "success": "logRejected"
      }
    },
    {
      "id": "logRejected",
      "name": "Log rejected",
      "kind": "logger",
      "message": "An approver rejected the contract: Status back to Draft",
      "next": "finish"
    },
    {
      "id": "finish",
      "name": "Finish",
      "kind": "finish"
    }
  ],
  "errorNotify": [
    "submitter"
  ]
}
