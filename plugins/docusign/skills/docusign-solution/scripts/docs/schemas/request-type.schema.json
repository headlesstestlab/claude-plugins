{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/docusign-skills/docs/schemas/request-type.schema.json",
  "title": "Agreement Desk request type (agreementdeskrequesttype/<id>.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "webFormId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "webFormId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "modelName": {
      "type": "string"
    },
    "modelVersion": {
      "type": "string"
    },
    "formState": {
      "enum": [
        "active",
        "draft"
      ]
    },
    "hasDraftChanges": {
      "type": "boolean"
    },
    "webFormsBuilderResponsePayload": {},
    "isDefault": {
      "type": "boolean"
    },
    "isEnabled": {
      "type": "boolean"
    }
  }
}
