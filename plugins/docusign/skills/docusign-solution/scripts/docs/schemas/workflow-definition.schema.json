{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/docusign-skills/docs/schemas/workflow-definition.schema.json",
  "title": "Workflow Builder definition (maestroworkflow/<id>/workflow-definition.json)",
  "description": "One Workflow Builder workflow, as stored in an Import Workflow package. See docs/ASSET-FORMATS.md#workflow-definition.",
  "type": "object",
  "required": [
    "workflowName",
    "documentVersion",
    "schemaVersion",
    "participants",
    "trigger",
    "variables",
    "steps"
  ],
  "properties": {
    "workflowName": {
      "type": "string",
      "minLength": 1
    },
    "workflowDescription": {
      "type": "string"
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "documentVersion": {
      "const": "1.0.0"
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "participants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/participant"
      }
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/reference"
      }
    },
    "steps": {
      "$ref": "#/$defs/steps"
    },
    "instanceName": {
      "if": {
        "type": "array"
      },
      "then": {
        "items": {
          "$ref": "#/$defs/reference"
        }
      },
      "else": {
        "$ref": "#/$defs/editorDoc"
      }
    },
    "workflowSource": {
      "type": "object",
      "properties": {
        "creatorSourceType": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "step",
            "participant"
          ]
        },
        "stepId": {
          "type": "string"
        },
        "propertyName": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "participantId": {
          "type": "string"
        },
        "key": {
          "enum": [
            "name",
            "email",
            "phone",
            "userId"
          ]
        },
        "type": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "moduleName": {
          "type": "string"
        },
        "stepName": {
          "type": "string"
        },
        "fullyQualifiedPath": {
          "type": "string"
        },
        "enumOptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultValue": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "participant"
              }
            }
          },
          "then": {
            "required": [
              "participantId",
              "key"
            ]
          },
          "else": {
            "required": [
              "stepId"
            ],
            "anyOf": [
              {
                "required": [
                  "propertyName"
                ]
              },
              {
                "required": [
                  "path"
                ]
              }
            ]
          }
        }
      ]
    },
    "editorDoc": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "paragraph"
                ]
              },
              "content": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "text",
                        "mention",
                        "hardBreak"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "marks": {
                      "type": "array"
                    },
                    "attrs": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "participant": {
      "type": "object",
      "required": [
        "participantId",
        "participantRole",
        "participantInfo"
      ],
      "properties": {
        "participantId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "participantRole": {
          "type": "string"
        },
        "participantType": {
          "enum": [
            "WorkflowBuilder",
            "WorkflowPreparer",
            "AgreementDeskRequestSubmitter",
            "AgreementDeskRequestOwner"
          ]
        },
        "participantObjectType": {
          "enum": [
            "WorkflowBuilder",
            "WorkflowPreparer"
          ]
        },
        "participantInfo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "userId": {
              "type": "string"
            }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "name",
        "id",
        "type",
        "httpType",
        "input",
        "output"
      ],
      "properties": {
        "name": {
          "const": "Get_URL"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "type": {
          "enum": [
            "Url",
            "API",
            "Manual",
            "Event",
            "From a Schedule",
            "Agreement-Desk",
            "CLM-Workflow"
          ]
        },
        "httpType": {
          "enum": [
            "Get",
            "Post"
          ]
        },
        "eventTriggerType": {
          "type": "string",
          "pattern": "^(envelope|recipient|workflow|ticket|insights|at-a-fixed-time|Based-on-a-Date-Field)[a-z-]*$"
        },
        "eventConditionalRules": {
          "$ref": "#/$defs/booleanExpression"
        },
        "input": {
          "type": "object",
          "required": [
            "payload"
          ],
          "properties": {
            "payload": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/reference"
              }
            },
            "participants": {
              "type": "object"
            },
            "metadata": {
              "type": "object"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/reference"
          }
        },
        "fixedTimeSchedule": {
          "type": "object",
          "required": [
            "type",
            "startDateTime"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Agreement-Desk",
                  "Event"
                ]
              }
            }
          },
          "then": {
            "required": [
              "eventTriggerType"
            ]
          }
        }
      ]
    },
    "booleanExpression": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "BooleanExpression",
            "ComparisonExpression",
            "UnaryComparisonExpression"
          ]
        },
        "logicalOperator": {
          "enum": [
            "And",
            "Or"
          ]
        },
        "expressions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/booleanExpression"
          }
        },
        "comparisonOperator": {
          "type": "string"
        },
        "caseSensitive": {
          "type": "boolean"
        }
      }
    },
    "senderField": {
      "type": "object",
      "required": [
        "name",
        "label",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "Text",
            "TextBox",
            "Date",
            "Number",
            "Select",
            "TableRow",
            "text",
            "date",
            "select",
            "number"
          ]
        },
        "required": {
          "enum": [
            "True",
            "False"
          ]
        },
        "value": {
          "$ref": "#/$defs/reference"
        },
        "fullyQualifiedPath": {
          "type": "string"
        }
      }
    },
    "envelopeRecipient": {
      "type": "object",
      "required": [
        "recipientId",
        "roleName",
        "name",
        "email"
      ],
      "properties": {
        "recipientId": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}_\\d+$|^\\d+$"
        },
        "roleName": {
          "type": "string"
        },
        "routingOrder": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/reference"
        },
        "email": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "name",
        "moduleName",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "moduleName": {
          "anyOf": [
            {
              "enum": [
                "ACT_Install_Step",
                "CLM-DownloadClmDocumentsAndAddToEnvelope",
                "CLM-SendDataToCLM",
                "CLM-StoreFilesInClm",
                "DocumentGenerationExperience",
                "End",
                "ESign-CallApi",
                "GenericNotification-SendEmail",
                "GetAgreementMetadata",
                "IDV-ExtractID",
                "IDV-RiskAssessment",
                "IDV-VerifyID-V2",
                "IfElse",
                "Impersonation",
                "Lookup",
                "Notification-SendEmail",
                "Parallel",
                "PrepareESignTemplate",
                "SendDocumentsForSignature",
                "ShowConfirmationScreen",
                "SwitchCase",
                "TicketAddApproval",
                "TicketAddFollowers",
                "TicketAddPermissions",
                "TicketChangeRequestTitle",
                "TicketCreateRequest",
                "TicketGetRequestDocument",
                "TicketRunPlaybook",
                "TicketSendRequestMessage",
                "TicketSetDueDate",
                "TicketSetOwner",
                "TicketSetStatus",
                "UseCustomAIAgent",
                "WebForms",
                "WebRequest"
              ]
            },
            {
              "pattern": "^3p-module-[0-9a-f-]+(-(DataInput|DataOutput))?$"
            }
          ]
        },
        "type": {
          "enum": [
            "DS-ACTInstallStep",
            "DS-ACTStep",
            "DS-ActFileArchive",
            "DS-CallESignApi",
            "DS-CallServiceStep",
            "DS-DocumentGenerationExperience",
            "DS-DownloadClmDocumentsAndAddToEnvelope",
            "DS-EmailNotification",
            "DS-End",
            "DS-IDV",
            "DS-IDV-V2",
            "DS-IfElse",
            "DS-Impersonation",
            "DS-Lookup",
            "DS-Parallel",
            "DS-SendDataToCLM",
            "DS-ShowScreenStep",
            "DS-SignPrepareESignTemplate",
            "DS-SignSendDocumentsForSignature",
            "DS-StoreFilesInClm",
            "DS-SwitchCase",
            "DS-TicketAddApproval",
            "DS-TicketAddFollowers",
            "DS-TicketAddPermissions",
            "DS-TicketChangeRequestTitle",
            "DS-TicketCreateRequest",
            "DS-TicketGetRequestDocument",
            "DS-TicketRunPlaybook",
            "DS-TicketSendRequestMessage",
            "DS-TicketSetDueDate",
            "DS-TicketSetOwner",
            "DS-TicketSetStatus",
            "DS-UseCustomAIAgent",
            "DS-WebForms",
            "DS-WebRequest"
          ]
        },
        "configurationProgress": {
          "enum": [
            "Completed",
            "NotStarted",
            "InProgress"
          ]
        },
        "config": {
          "type": "object"
        },
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "WebForms"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-WebForms"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "DocumentGenerationExperience"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-DocumentGenerationExperience"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "SendDocumentsForSignature"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-SignSendDocumentsForSignature"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "PrepareESignTemplate"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-SignPrepareESignTemplate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "UseCustomAIAgent"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-UseCustomAIAgent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketSetOwner"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketSetOwner"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketSetStatus"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketSetStatus"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketSetDueDate"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketSetDueDate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketAddApproval"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketAddApproval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketAddFollowers"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketAddFollowers"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketSendRequestMessage"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketSendRequestMessage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "SwitchCase"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-SwitchCase"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "GenericNotification-SendEmail"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-CallServiceStep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "Notification-SendEmail"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-EmailNotification"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketCreateRequest"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketCreateRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketAddPermissions"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketAddPermissions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "IDV-ExtractID"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-IDV"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "Parallel"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-Parallel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketChangeRequestTitle"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketChangeRequestTitle"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketGetRequestDocument"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-TicketGetRequestDocument"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "IDV-RiskAssessment"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-IDV-V2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "IDV-VerifyID-V2"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-IDV-V2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "Impersonation"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-Impersonation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "GetAgreementMetadata"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-CallServiceStep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "ShowConfirmationScreen"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-ShowScreenStep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "IfElse"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-IfElse"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "End"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-End"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "ACT_Install_Step"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-ACTInstallStep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "CLM-SendDataToCLM"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "DS-SendDataToCLM"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "moduleName": {
                "const": "TicketRunPlaybook"
              }
            },
            "required": [
              "moduleName"
            ]
          },
          "then": {
