{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/docusign-skills/docs/schemas/custom-field.schema.json",
  "title": "Account custom field (customfield/C_<Name>.json): a Concerto concept declaration",
  "description": "Two shapes are observed: a request-type export wraps the declaration as { declaration, dcsCommands }; a workflow export stores the bare ConceptDeclaration.",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "declaration",
        "dcsCommands"
      ],
      "properties": {
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "dcsCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "target",
              "decorator"
            ],
            "properties": {
              "type": {
                "const": "UPSERT"
              },
              "decorator": {
                "type": "object",
                "properties": {
                  "name": {
                    "enum": [
                      "OptionKeys",
                      "Term_OptionValues",
                      "DeprecatedOptionKeys"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$ref": "#/$defs/declaration"
    }
  ],
  "$defs": {
    "decorator": {
      "type": "object",
      "required": [
        "$class",
        "name"
      ],
      "properties": {
        "$class": {
          "const": "concerto.metamodel@1.0.0.Decorator"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "array"
        }
      }
    },
    "declaration": {
      "type": "object",
      "required": [
        "$class",
        "name",
        "superType",
        "decorators",
        "properties"
      ],
      "properties": {
        "$class": {
          "const": "concerto.metamodel@1.0.0.ConceptDeclaration"
        },
        "name": {
          "type": "string",
          "pattern": "^C_[A-Za-z0-9_]+$"
        },
        "isAbstract": {
          "const": false
        },
        "superType": {
          "type": "object",
          "required": [
            "name",
            "namespace"
          ],
          "properties": {
            "name": {
              "const": "Provision"
            },
            "namespace": {
              "type": "string",
              "pattern": "^com\\.docusign\\.platform\\.provision@[0-9.]+$"
            }
          }
        },
        "decorators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decorator"
          }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "$class",
              "name"
            ],
            "properties": {
              "$class": {
                "enum": [
                  "concerto.metamodel@1.0.0.StringProperty",
                  "concerto.metamodel@1.0.0.DateTimeProperty",
                  "concerto.metamodel@1.0.0.DoubleProperty",
                  "concerto.metamodel@1.0.0.IntegerProperty",
                  "concerto.metamodel@1.0.0.BooleanProperty",
                  "concerto.metamodel@1.0.0.ObjectProperty"
                ]
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
