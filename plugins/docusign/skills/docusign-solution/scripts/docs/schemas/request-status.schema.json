{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/docusign-skills/docs/schemas/request-status.schema.json",
  "title": "Agreement Desk request status (agreementdeskrequeststatus/<id>.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "state": {
      "enum": [
        "Open",
        "Closed"
      ]
    },
    "color": {
      "type": "string"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "isDeleted": {
      "type": "boolean"
    }
  }
}
