{
  "id": "dpa-request",
  "name": "Data Processing Agreement",
  "description": "A DPA for a vendor or customer that will process personal data: roles, transfers, special-category data, sub-processors and security.",
  "pages": [
    {
      "title": "Data Processing Agreement",
      "fields": [
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Counterparty",
          "required": true
        },
        {
          "key": "existing",
          "type": "text",
          "label": "Existing agreement",
          "bind": {
            "custom": "IntakeExistingAgreement",
            "label": "Related Agreement"
          },
          "required": true,
          "description": "The main agreement this DPA attaches to: CLM ID or exact title."
        },
        {
          "key": "side",
          "type": "dropdown",
          "label": "Is Fontara buying or selling?",
          "bind": {
            "custom": "DeskDealSide",
            "label": "Buying or Selling",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Buying: Fontara is the customer",
            "Selling: Fontara is the supplier",
            "Neither or mutual"
          ],
          "required": true,
          "description": "Decides whose template applies and who signs: the Head of Procurement (Victoria Lee) when buying, the VP of Sales (Corey Ikso) when selling, the CFO (Marcus Chen) over $1,000,000. Legal Operations (Maya Patel) reviews; non-standard terms go to the General Counsel (Elena Rodriguez)."
        },
        {
          "key": "data_role",
          "type": "dropdown",
          "label": "Fontara is the",
          "bind": {
            "custom": "DeskDataRole",
            "label": "Fontara Data Role",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Controller",
            "Processor",
            "Sub-processor",
            "Joint controller"
          ],
          "required": true,
          "description": "Controller: Fontara decides why the data is processed. Processor: we process it for a customer."
        },
        {
          "key": "data_details",
          "type": "longtext",
          "label": "What personal data, about whom?",
          "bind": {
            "custom": "IntakeDataDetails",
            "label": "Personal Data Description"
          },
          "required": true,
          "description": "Categories of data and of people, e.g. customer employees' names and work emails."
        },
        {
          "key": "data_class",
          "type": "dropdown",
          "label": "Data classification",
          "bind": {
            "custom": "DeskDataClass",
            "label": "Data Class",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted (special-category, children's or financial data)"
          ],
          "required": true
        },
        {
          "key": "special_note",
          "type": "description",
          "text": "Special-category or children's data needs a data protection impact assessment before signature. The Data Protection Officer (Alexandra Kim) will contact you."
        },
        {
          "key": "regions",
          "type": "dropdown",
          "label": "Where are the people whose data it is?",
          "bind": {
            "custom": "DeskDataRegions",
            "label": "Data Regions",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "EU or EEA",
            "United Kingdom",
            "United States",
            "Multiple regions",
            "Other"
          ],
          "required": true
        },
        {
          "key": "transfer",
          "type": "dropdown",
          "label": "Will personal data move outside the EEA or UK, or into them from elsewhere?",
          "bind": {
            "custom": "DeskDataTransfer",
            "label": "Transfer Mechanism",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "No transfer",
            "Yes: EU SCCs",
            "Yes: UK IDTA or Addendum",
            "Yes: EU-US Data Privacy Framework",
            "Yes: adequacy decision",
            "Yes: mechanism not yet known"
          ],
          "required": true,
          "description": "The transfer mechanism, if you know it. The Data Protection Officer (Alexandra Kim) will confirm."
        },
        {
          "key": "subcontractors",
          "type": "dropdown",
          "label": "Will sub-processors be used?",
          "bind": {
            "custom": "DeskSubprocessors",
            "label": "Sub-processors Used",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No",
            "Unknown"
          ],
          "required": true
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Where will the data go, and who are the sub-processors?",
          "bind": {
            "custom": "RequestDescription"
          }
        },
        {
          "key": "security_review",
          "type": "dropdown",
          "label": "Vendor risk review status",
          "bind": {
            "custom": "DeskSecurityReview",
            "label": "Security Review Stage",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Not started",
            "In progress",
            "Complete",
            "Not applicable"
          ],
          "required": true
        },
        {
          "key": "paper",
          "type": "dropdown",
          "label": "Whose DPA?",
          "bind": {
            "custom": "DeskPaperSource",
            "label": "Whose Paper",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara's paper",
            "Counterparty's paper"
          ],
          "required": true,
          "description": "Our template means Fontara's standard DPA. Counterparty's paper means theirs."
        },
        {
          "key": "their_dpa",
          "type": "file",
          "label": "Counterparty's DPA"
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "country",
          "type": "dropdown",
          "label": "Counterparty country",
          "bind": {
            "custom": "DeskCountry",
            "label": "Country of Counterparty",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "United States",
            "United Kingdom",
            "Australia",
            "Austria",
            "Belgium",
            "Brazil",
            "Bulgaria",
            "Canada",
            "China",
            "Croatia",
            "Cyprus",
            "Czechia",
            "Denmark",
            "Estonia",
            "Finland",
            "France",
            "Germany",
            "Greece",
            "Hungary",
            "India",
            "Ireland",
            "Israel",
            "Italy",
            "Japan",
            "Latvia",
            "Lithuania",
            "Luxembourg",
            "Malta",
            "Mexico",
            "Netherlands",
            "New Zealand",
            "Norway",
            "Poland",
            "Portugal",
            "Romania",
            "Singapore",
            "Slovakia",
            "Slovenia",
            "South Africa",
            "South Korea",
            "Spain",
            "Sweden",
            "Switzerland",
            "United Arab Emirates",
            "Other"
          ],
          "required": true,
          "description": "Where the other party is established. It drives governing law, data-transfer and tax review."
        },
        {
          "key": "effective",
          "bind": {
            "provision": "EffectiveDate"
          },
          "label": "Effective date"
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Business owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Supporting documents"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "data_class",
          "is": "Restricted (special-category, children's or financial data)"
        }
      ],
      "then": {
        "special_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "subcontractors",
          "is": "Yes"
        }
      ],
      "then": {
        "details": "show"
      }
    },
    {
      "when": [
        {
          "field": "paper",
          "is": "Counterparty's paper"
        }
      ],
      "then": {
        "their_dpa": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
