{
  "id": "order-form-request",
  "name": "Order Form Request",
  "description": "An order form for products or subscriptions under an existing customer agreement: term, pricing, discount and PO.",
  "pages": [
    {
      "title": "Order Form Request",
      "fields": [
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Customer",
          "required": true
        },
        {
          "key": "crm_id",
          "type": "text",
          "label": "Salesforce opportunity ID",
          "bind": {
            "custom": "IntakeCrmId",
            "label": "CRM Opportunity ID"
          },
          "required": true,
          "description": "From the opportunity URL: 15 or 18 characters starting 006.",
          "pattern": {
            "regex": "^006[A-Za-z0-9]{12,15}$",
            "message": "A Salesforce opportunity ID starts with 006 and is 15 or 18 characters.",
            "example": "006Hs00001AbCdEIAV"
          }
        },
        {
          "key": "existing",
          "type": "text",
          "label": "Existing agreement",
          "bind": {
            "custom": "IntakeExistingAgreement",
            "label": "Related Agreement"
          },
          "required": true,
          "description": "The customer agreement it sits under: CLM ID or exact title, e.g. 'Acme MSA 2024'."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "value",
          "bind": {
            "provision": "ContractValue"
          },
          "label": "Total contract value (TCV)",
          "required": true,
          "description": "All years, excluding tax."
        },
        {
          "key": "approver",
          "type": "text",
          "label": "Deal desk approver",
          "bind": {
            "custom": "IntakeApprover",
            "label": "Budget Approver"
          },
          "description": "Over $1,000,000 total: the VP of Sales (Corey Ikso), who approves with the CFO (Marcus Chen)."
        },
        {
          "key": "discount",
          "type": "number",
          "label": "Discount off list (%)",
          "bind": {
            "custom": "IntakeDiscount",
            "label": "Discount Percent"
          },
          "required": true,
          "description": "The overall discount from list price. 0 if none."
        },
        {
          "key": "discount_note",
          "type": "description",
          "text": "Over 30% off list needs deal desk approval before Legal can paper it. Attach the approval below."
        },
        {
          "key": "term_months",
          "type": "number",
          "label": "Subscription term (months)",
          "bind": {
            "custom": "IntakeTermMonths",
            "label": "Term in Months"
          },
          "required": true
        },
        {
          "key": "billing",
          "type": "dropdown",
          "label": "Pricing and billing",
          "bind": {
            "custom": "DeskBilling",
            "label": "Billing Model",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Subscription billed annually upfront",
            "Subscription billed quarterly",
            "Subscription billed monthly",
            "Usage-based",
            "One-time fee"
          ],
          "required": true
        },
        {
          "key": "payment_terms",
          "bind": {
            "provision": "PaymentTerms"
          },
          "label": "Payment terms",
          "required": true
        },
        {
          "key": "po_number",
          "type": "text",
          "label": "Customer PO number",
          "bind": {
            "custom": "IntakeReferenceId",
            "label": "External Reference ID"
          },
          "description": "Only if the customer requires a PO on the order form."
        },
        {
          "key": "effective",
          "bind": {
            "provision": "EffectiveDate"
          },
          "label": "Effective date"
        },
        {
          "key": "expiration",
          "bind": {
            "provision": "ExpirationDate"
          },
          "label": "Expiration date"
        },
        {
          "key": "renewal_type",
          "bind": {
            "provision": "RenewalType"
          },
          "label": "Renewal type"
        },
        {
          "key": "non_standard",
          "type": "dropdown",
          "label": "Does the order change any standard terms?",
          "bind": {
            "custom": "DeskNonStandard",
            "label": "Non-standard Terms",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Which terms, and why?",
          "bind": {
            "custom": "RequestDescription"
          }
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Account owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The account executive who owns the deal."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed to close by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Quote and approvals"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "non_standard",
          "is": "Yes"
        }
      ],
      "then": {
        "details": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
