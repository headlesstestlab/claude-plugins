{
  "id": "legal-process-received",
  "name": "Subpoena or Legal Process",
  "description": "A subpoena, court order, law-enforcement request or regulator inquiry served on Fontara. Send it the day it arrives.",
  "pages": [
    {
      "title": "Subpoena or Legal Process",
      "fields": [
        {
          "key": "process_type",
          "type": "dropdown",
          "label": "What was received?",
          "bind": {
            "custom": "DeskProcessType",
            "label": "Legal Process Type",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Subpoena",
            "Court order",
            "Law-enforcement request",
            "Regulator inquiry",
            "Other"
          ],
          "required": true
        },
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Issuing court, agency or party",
          "required": true
        },
        {
          "key": "reference",
          "type": "text",
          "label": "Case or reference number",
          "bind": {
            "custom": "IntakeReferenceId",
            "label": "External Reference ID"
          },
          "description": "As printed on the document."
        },
        {
          "key": "aware",
          "type": "date",
          "label": "When was it served or received?",
          "bind": {
            "custom": "IntakeAwareDate",
            "label": "Date Received or Discovered"
          },
          "required": true,
          "description": "Response deadlines run from this date."
        },
        {
          "key": "personal_data",
          "type": "dropdown",
          "label": "Does it ask for customer or employee data?",
          "bind": {
            "custom": "DeskPersonalData",
            "label": "Personal Data Involved",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No",
            "Not sure"
          ],
          "required": true,
          "description": "Customer data requests may require notice to the customer under our agreements."
        },
        {
          "key": "data_details",
          "type": "longtext",
          "label": "What personal data, about whom, and where will it be stored?",
          "bind": {
            "custom": "IntakeDataDetails",
            "label": "Personal Data Description"
          },
          "description": "For example: customer contact names and emails, stored in the vendor's EU data centre."
        },
        {
          "key": "data_class",
          "type": "dropdown",
          "label": "Data classification",
          "bind": {
            "custom": "DeskDataClass",
            "label": "Data Class",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted (special-category, children's or financial data)"
          ],
          "description": "The highest class of Fontara data involved. Restricted data needs Security/IT's vendor risk review before signature."
        },
        {
          "key": "privacy_note",
          "type": "description",
          "text": "The Data Protection Officer (Alexandra Kim) will follow up to confirm whether personal data is involved. If it is, and no existing DPA covers it, a DPA is needed before signature."
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "How did it arrive, and who has seen it?",
          "bind": {
            "custom": "RequestDescription"
          },
          "required": true,
          "description": "Served in person, by post or by email, and to whom. Do not respond to the requester yourself."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Recipient",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person it was served on or sent to."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Response deadline",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "The date printed on the document, if any.",
          "required": true
        },
        {
          "key": "documents",
          "type": "file",
          "label": "The document received",
          "required": true
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Yes"
        }
      ],
      "then": {
        "data_details": "show",
        "data_class": "show"
      }
    },
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Not sure"
        }
      ],
      "then": {
        "privacy_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
