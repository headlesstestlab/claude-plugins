{
  "id": "vendor-extension-letter",
  "name": "Vendor Extension Letter",
  "description": "Extend a supplier agreement for a short period, usually on its current terms, while a renewal, RFP or project completes.",
  "pages": [
    {
      "title": "Vendor Extension Letter",
      "fields": [
        {
          "key": "existing",
          "type": "text",
          "label": "Existing agreement",
          "bind": {
            "custom": "IntakeExistingAgreement",
            "label": "Related Agreement"
          },
          "required": true,
          "description": "The agreement being extended: CLM ID or exact title. Legal reads its current end date from the record."
        },
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Vendor",
          "required": true
        },
        {
          "key": "reason",
          "type": "dropdown",
          "label": "Why extend?",
          "bind": {
            "custom": "DeskExtensionReason",
            "label": "Extension Reason",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Bridge while renegotiating",
            "RFP in progress",
            "Project delay",
            "Other"
          ],
          "required": true
        },
        {
          "key": "expiration",
          "bind": {
            "provision": "ExpirationDate"
          },
          "label": "New end date",
          "required": true
        },
        {
          "key": "non_standard",
          "type": "dropdown",
          "label": "Will anything change from the current terms or pricing?",
          "bind": {
            "custom": "DeskNonStandard",
            "label": "Non-standard Terms",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "What changes?",
          "bind": {
            "custom": "RequestDescription"
          },
          "description": "Pricing, scope or service levels that differ from the current agreement."
        },
        {
          "key": "value",
          "bind": {
            "provision": "ContractValue"
          },
          "label": "Extension total contract value (TCV)",
          "required": false,
          "description": "The additional spend for the extension period only, excluding tax."
        },
        {
          "key": "cost_center",
          "type": "text",
          "label": "Cost center",
          "bind": {
            "custom": "IntakeCostCenter",
            "label": "Cost Center"
          },
          "required": false,
          "description": "The cost center that pays, e.g. 4100-Marketing."
        },
        {
          "key": "po_number",
          "type": "text",
          "label": "PO to extend",
          "bind": {
            "custom": "IntakeReferenceId",
            "label": "External Reference ID"
          },
          "description": "The purchase order number Finance will extend."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Business owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "non_standard",
          "is": "Yes"
        }
      ],
      "then": {
        "details": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
