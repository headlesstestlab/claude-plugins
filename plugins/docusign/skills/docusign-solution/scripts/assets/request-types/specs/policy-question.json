{
  "id": "policy-question",
  "name": "Policy Question",
  "description": "Ask about privacy, gifts and anti-bribery, conflicts, export controls, insider trading or an ethics concern.",
  "pages": [
    {
      "title": "Policy Question",
      "fields": [
        {
          "key": "topic",
          "type": "dropdown",
          "label": "Topic",
          "bind": {
            "custom": "DeskPolicyTopic",
            "label": "Policy Area",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Data privacy",
            "Gifts, hospitality or anti-bribery",
            "Conflicts of interest",
            "Export controls or sanctions",
            "Insider trading",
            "Whistleblowing or ethics concern",
            "Other"
          ],
          "required": true
        },
        {
          "key": "gov_official",
          "type": "dropdown",
          "label": "Is a government official or public-sector employee involved?",
          "bind": {
            "custom": "DeskGovOfficial",
            "label": "Government Official",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No",
            "Not sure"
          ],
          "description": "Includes employees of state-owned companies. Anything of value to an official needs pre-approval."
        },
        {
          "key": "hotline_note",
          "type": "description",
          "text": "You can raise an ethics concern anonymously through the Fontara Ethics Hotline. Retaliation against anyone who raises a concern in good faith is prohibited."
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Your question",
          "bind": {
            "custom": "RequestDescription"
          },
          "required": true,
          "description": "For gifts or hospitality, include who, what and the approximate value."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": false,
          "description": "The Fontara company involved, if any."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Your manager",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The manager who should know about the answer."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Supporting documents"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "topic",
          "is": "Gifts, hospitality or anti-bribery"
        }
      ],
      "then": {
        "gov_official": "show"
      }
    },
    {
      "when": [
        {
          "field": "topic",
          "is": "Whistleblowing or ethics concern"
        }
      ],
      "then": {
        "hotline_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
