{
  "id": "settlement-agreement",
  "name": "Settlement Agreement",
  "description": "Settle a dispute with an employee, customer, vendor or other party: the amount, the release and confidentiality terms.",
  "pages": [
    {
      "title": "Settlement Agreement",
      "fields": [
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Other party",
          "required": true
        },
        {
          "key": "counterparty_type",
          "type": "dropdown",
          "label": "Who is the other party?",
          "bind": {
            "custom": "DeskSettlementParty",
            "label": "Settling Party",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Employee or former employee",
            "Customer",
            "Vendor or supplier",
            "Other third party"
          ],
          "required": true
        },
        {
          "key": "dispute",
          "type": "dropdown",
          "label": "Status of the dispute",
          "bind": {
            "custom": "DeskSettlementStage",
            "label": "Dispute Stage",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Dispute or claim threatened",
            "Claim filed",
            "Investigation opened"
          ],
          "required": true
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Dispute summary",
          "bind": {
            "custom": "RequestDescription"
          },
          "required": true,
          "description": "What is claimed, what has been offered, and outside counsel if one is engaged."
        },
        {
          "key": "value",
          "bind": {
            "provision": "ContractValue"
          },
          "label": "Settlement amount (TCV)",
          "required": true,
          "description": "The total Fontara pays or receives, all instalments, excluding tax."
        },
        {
          "key": "approver",
          "type": "text",
          "label": "General Counsel approver",
          "bind": {
            "custom": "IntakeApprover",
            "label": "Budget Approver"
          },
          "description": "The General Counsel (Elena Rodriguez), or her delegate, who approved the settlement."
        },
        {
          "key": "non_standard",
          "type": "dropdown",
          "label": "Are confidentiality or non-disparagement terms wanted?",
          "bind": {
            "custom": "DeskNonStandard",
            "label": "Non-standard Terms",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "country",
          "type": "dropdown",
          "label": "Counterparty country",
          "bind": {
            "custom": "DeskCountry",
            "label": "Country of Counterparty",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "United States",
            "United Kingdom",
            "Australia",
            "Austria",
            "Belgium",
            "Brazil",
            "Bulgaria",
            "Canada",
            "China",
            "Croatia",
            "Cyprus",
            "Czechia",
            "Denmark",
            "Estonia",
            "Finland",
            "France",
            "Germany",
            "Greece",
            "Hungary",
            "India",
            "Ireland",
            "Israel",
            "Italy",
            "Japan",
            "Latvia",
            "Lithuania",
            "Luxembourg",
            "Malta",
            "Mexico",
            "Netherlands",
            "New Zealand",
            "Norway",
            "Poland",
            "Portugal",
            "Romania",
            "Singapore",
            "Slovakia",
            "Slovenia",
            "South Africa",
            "South Korea",
            "Spain",
            "Sweden",
            "Switzerland",
            "United Arab Emirates",
            "Other"
          ],
          "required": true,
          "description": "Where the other party is established. It drives governing law, data-transfer and tax review."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Business owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Claim letter, offer or draft"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
