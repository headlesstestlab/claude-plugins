{
  "id": "marketing-review",
  "name": "Marketing Review",
  "description": "Legal review of a campaign, asset or claim before it goes out: claims, customer logos, promotions, endorsements and data collection.",
  "pages": [
    {
      "title": "Marketing Review",
      "fields": [
        {
          "key": "subject_title_note",
          "type": "description",
          "text": "**Campaign or asset name:** put it in the request title above the form."
        },
        {
          "key": "channel",
          "type": "dropdown",
          "label": "Channel",
          "bind": {
            "custom": "DeskChannel",
            "label": "Marketing Channel",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Web",
            "Email",
            "Social",
            "Print",
            "Event",
            "Other"
          ],
          "required": true
        },
        {
          "key": "regions",
          "type": "dropdown",
          "label": "Target regions",
          "bind": {
            "custom": "DeskMarkets",
            "label": "Markets",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "United States",
            "United Kingdom",
            "EU or EEA",
            "Global"
          ],
          "required": true,
          "description": "UK (ASA/CAP) and EU (UCPD) advertising rules differ from the US."
        },
        {
          "key": "launch",
          "bind": {
            "provision": "EffectiveDate"
          },
          "label": "Launch date",
          "required": true
        },
        {
          "key": "claims",
          "type": "dropdown",
          "label": "Does it make product, performance or comparative claims?",
          "bind": {
            "custom": "DeskClaims",
            "label": "Makes Marketing Claims",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Which claims, and what substantiates them?",
          "bind": {
            "custom": "RequestDescription"
          },
          "description": "Link the data, test or study behind each claim."
        },
        {
          "key": "trademark",
          "type": "dropdown",
          "label": "Does it use customer names, logos, testimonials, or third-party images, music or marks?",
          "bind": {
            "custom": "DeskThirdPartyMarks",
            "label": "Third-Party Marks Used",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "No",
            "Yes: written consent on file",
            "Yes: consent not yet obtained"
          ],
          "required": true
        },
        {
          "key": "consent_note",
          "type": "description",
          "text": "Legal needs written consent before anything is published with a customer's name, logo or quote, or a third party's image, music or mark."
        },
        {
          "key": "promotion",
          "type": "dropdown",
          "label": "Does it include a promotion or endorsement?",
          "bind": {
            "custom": "DeskPromotion",
            "label": "Promotion Type",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "None",
            "Contest or sweepstakes",
            "Influencer or paid endorsement",
            "Discount or special offer"
          ],
          "required": true
        },
        {
          "key": "official_rules",
          "type": "file",
          "label": "Official rules",
          "description": "Every contest or sweepstakes needs official rules."
        },
        {
          "key": "endorsement_note",
          "type": "description",
          "text": "Paid endorsements must be disclosed (FTC Endorsement Guides, ASA/CAP). Legal will check the disclosure wording."
        },
        {
          "key": "personal_data",
          "type": "dropdown",
          "label": "Does it collect personal data (sign-ups, lead forms, cookies)?",
          "bind": {
            "custom": "DeskPersonalData",
            "label": "Personal Data Involved",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No",
            "Not sure"
          ],
          "required": true,
          "description": "Yes routes to the Data Protection Officer (Alexandra Kim) for the notice and consent wording."
        },
        {
          "key": "data_details",
          "type": "longtext",
          "label": "What personal data, about whom, and where will it be stored?",
          "bind": {
            "custom": "IntakeDataDetails",
            "label": "Personal Data Description"
          },
          "description": "For example: customer contact names and emails, stored in the vendor's EU data centre."
        },
        {
          "key": "data_class",
          "type": "dropdown",
          "label": "Data classification",
          "bind": {
            "custom": "DeskDataClass",
            "label": "Data Class",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted (special-category, children's or financial data)"
          ],
          "description": "The highest class of Fontara data involved. Restricted data needs Security/IT's vendor risk review before signature."
        },
        {
          "key": "privacy_note",
          "type": "description",
          "text": "The Data Protection Officer (Alexandra Kim) will follow up to confirm whether personal data is involved. If it is, and no existing DPA covers it, a DPA is needed before signature."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Campaign owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Review needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "The asset",
          "required": true
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "claims",
          "is": "Yes"
        }
      ],
      "then": {
        "details": "show"
      }
    },
    {
      "when": [
        {
          "field": "trademark",
          "is": "Yes: consent not yet obtained"
        }
      ],
      "then": {
        "consent_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "promotion",
          "is": "Contest or sweepstakes"
        }
      ],
      "then": {
        "official_rules": "show"
      }
    },
    {
      "when": [
        {
          "field": "promotion",
          "is": "Influencer or paid endorsement"
        }
      ],
      "then": {
        "endorsement_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Yes"
        }
      ],
      "then": {
        "data_details": "show",
        "data_class": "show"
      }
    },
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Not sure"
        }
      ],
      "then": {
        "privacy_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
