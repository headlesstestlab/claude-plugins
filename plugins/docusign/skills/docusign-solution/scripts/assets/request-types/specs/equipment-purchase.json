{
  "id": "equipment-purchase",
  "name": "Equipment Purchase",
  "description": "Buy or lease equipment: what, how many, how it is acquired, whether the vendor works on site, and who pays.",
  "pages": [
    {
      "title": "Equipment Purchase",
      "fields": [
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Vendor",
          "required": true
        },
        {
          "key": "subject_title_note",
          "type": "description",
          "text": "**Equipment description and model:** put it in the request title above the form."
        },
        {
          "key": "quantity",
          "type": "number",
          "label": "Quantity",
          "bind": {
            "custom": "IntakeQuantity",
            "label": "Quantity"
          },
          "required": true
        },
        {
          "key": "acquisition",
          "type": "dropdown",
          "label": "Buy or lease?",
          "bind": {
            "custom": "DeskAcquisition",
            "label": "Acquisition Method",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Purchase",
            "Lease or rental"
          ],
          "required": true
        },
        {
          "key": "effective",
          "bind": {
            "provision": "EffectiveDate"
          },
          "label": "Lease start"
        },
        {
          "key": "expiration",
          "bind": {
            "provision": "ExpirationDate"
          },
          "label": "Lease end"
        },
        {
          "key": "onsite",
          "type": "dropdown",
          "label": "Will the vendor install or work on site?",
          "bind": {
            "custom": "DeskOnsite",
            "label": "Site or System Access",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ],
          "required": true,
          "description": "On-site work needs insurance and health-and-safety terms."
        },
        {
          "key": "value",
          "bind": {
            "provision": "ContractValue"
          },
          "label": "Total contract value (TCV)",
          "required": true,
          "description": "All years, excluding tax."
        },
        {
          "key": "approver",
          "type": "text",
          "label": "Budget approver",
          "bind": {
            "custom": "IntakeApprover",
            "label": "Budget Approver"
          },
          "description": "Up to $1,000,000 total: the Head of Procurement (Victoria Lee). Over $1,000,000: the CFO (Marcus Chen)."
        },
        {
          "key": "cost_center",
          "type": "text",
          "label": "Cost center",
          "bind": {
            "custom": "IntakeCostCenter",
            "label": "Cost Center"
          },
          "required": true,
          "description": "The cost center that pays, e.g. 4100-Marketing."
        },
        {
          "key": "po_number",
          "type": "text",
          "label": "PO number",
          "bind": {
            "custom": "IntakeReferenceId",
            "label": "External Reference ID"
          },
          "description": "If Finance has raised one already."
        },
        {
          "key": "payment_terms",
          "bind": {
            "provision": "PaymentTerms"
          },
          "label": "Payment terms"
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Warranty, delivery and installation",
          "bind": {
            "custom": "RequestDescription"
          },
          "description": "Warranty period, delivery date and site, installation services."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Budget owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Quote"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "acquisition",
          "is": "Lease or rental"
        }
      ],
      "then": {
        "effective": "show",
        "expiration": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
