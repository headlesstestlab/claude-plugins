{
  "id": "new-customer-intake",
  "name": "New Customer Intake",
  "description": "Everything Legal needs to paper a new customer: the opportunity, the entity, the value and whether personal data is involved.",
  "pages": [
    {
      "title": "New Customer Intake",
      "fields": [
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Customer",
          "required": true,
          "description": "The customer's legal name, as registered."
        },
        {
          "key": "crm_id",
          "type": "text",
          "label": "Salesforce opportunity ID",
          "bind": {
            "custom": "IntakeCrmId",
            "label": "CRM Opportunity ID"
          },
          "required": true,
          "description": "From the opportunity URL: 15 or 18 characters starting 006.",
          "pattern": {
            "regex": "^006[A-Za-z0-9]{12,15}$",
            "message": "A Salesforce opportunity ID starts with 006 and is 15 or 18 characters.",
            "example": "006Hs00001AbCdEIAV"
          }
        },
        {
          "key": "agreement_type",
          "type": "dropdown",
          "label": "Agreement type",
          "bind": {
            "custom": "DeskFirstAgreement",
            "label": "First Agreement Needed",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "MSA",
            "Order Form",
            "SOW",
            "Other"
          ],
          "required": true,
          "description": "For an NDA, use the NDA Request instead."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "country",
          "type": "dropdown",
          "label": "Counterparty country",
          "bind": {
            "custom": "DeskCountry",
            "label": "Country of Counterparty",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "United States",
            "United Kingdom",
            "Australia",
            "Austria",
            "Belgium",
            "Brazil",
            "Bulgaria",
            "Canada",
            "China",
            "Croatia",
            "Cyprus",
            "Czechia",
            "Denmark",
            "Estonia",
            "Finland",
            "France",
            "Germany",
            "Greece",
            "Hungary",
            "India",
            "Ireland",
            "Israel",
            "Italy",
            "Japan",
            "Latvia",
            "Lithuania",
            "Luxembourg",
            "Malta",
            "Mexico",
            "Netherlands",
            "New Zealand",
            "Norway",
            "Poland",
            "Portugal",
            "Romania",
            "Singapore",
            "Slovakia",
            "Slovenia",
            "South Africa",
            "South Korea",
            "Spain",
            "Sweden",
            "Switzerland",
            "United Arab Emirates",
            "Other"
          ],
          "required": true,
          "description": "Where the other party is established. It drives governing law, data-transfer and tax review."
        },
        {
          "key": "personal_data",
          "type": "dropdown",
          "label": "Will the customer give Fontara personal data to process?",
          "bind": {
            "custom": "DeskPersonalData",
            "label": "Personal Data Involved",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No",
            "Not sure"
          ],
          "required": true,
          "description": "For example, their employees' or end customers' data in our platform. If Yes, say whether an existing DPA already covers it."
        },
        {
          "key": "existing_dpa",
          "type": "dropdown",
          "label": "Is this covered by an existing DPA?",
          "options": [
            "Yes",
            "No"
          ],
          "bind": {
            "custom": "DeskExistingDpa",
            "label": "Existing DPA Covers It",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "description": "No, or new data categories, new sub-processors or a new cross-border transfer: the Data Protection Officer (Alexandra Kim) reviews it. Yes, with nothing new: no privacy review."
        },
        {
          "key": "data_details",
          "type": "longtext",
          "label": "What personal data, about whom, and where will it be stored?",
          "bind": {
            "custom": "IntakeDataDetails",
            "label": "Personal Data Description"
          },
          "description": "For example: customer contact names and emails, stored in the vendor's EU data centre."
        },
        {
          "key": "data_class",
          "type": "dropdown",
          "label": "Data classification",
          "bind": {
            "custom": "DeskDataClass",
            "label": "Data Class",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted (special-category, children's or financial data)"
          ],
          "description": "The highest class of Fontara data involved. Restricted data needs Security/IT's vendor risk review before signature."
        },
        {
          "key": "privacy_note",
          "type": "description",
          "text": "The Data Protection Officer (Alexandra Kim) will follow up to confirm whether personal data is involved. If it is, and no existing DPA covers it, a DPA is needed before signature."
        },
        {
          "key": "value",
          "bind": {
            "provision": "ContractValue"
          },
          "label": "Total contract value (TCV)",
          "required": true,
          "description": "All years, excluding tax."
        },
        {
          "key": "payment_terms",
          "bind": {
            "provision": "PaymentTerms"
          },
          "label": "Payment terms"
        },
        {
          "key": "effective",
          "bind": {
            "provision": "EffectiveDate"
          },
          "label": "Effective date"
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Account owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The account executive who owns the customer relationship."
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Anything Legal should know?",
          "bind": {
            "custom": "RequestDescription"
          },
          "description": "Deal context, competitors, special requests from the customer."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Supporting documents"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Yes"
        }
      ],
      "then": {
        "data_details": "show",
        "data_class": "show",
        "existing_dpa": "show"
      }
    },
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Not sure"
        }
      ],
      "then": {
        "privacy_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
