{
  "id": "dsar-escalation",
  "name": "Data Subject Request Escalation",
  "description": "Escalate a data subject request (access, deletion, correction, opt-out) to the Data Protection Officer (Alexandra Kim). Statutory clocks start when it is received.",
  "pages": [
    {
      "title": "Data Subject Request Escalation",
      "fields": [
        {
          "key": "request_type",
          "type": "dropdown",
          "label": "Request type",
          "bind": {
            "custom": "DeskDsarType",
            "label": "Data Subject Request Type",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Access",
            "Deletion",
            "Correction",
            "Opt-out of sale or sharing",
            "Portability",
            "Objection or restriction"
          ],
          "required": true
        },
        {
          "key": "regions",
          "type": "dropdown",
          "label": "Which law applies?",
          "bind": {
            "custom": "DeskPrivacyLaw",
            "label": "Privacy Law",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "EU GDPR",
            "UK GDPR",
            "California CCPA/CPRA",
            "Other US state law",
            "Other or unknown"
          ],
          "required": true
        },
        {
          "key": "aware",
          "type": "date",
          "label": "When was the request received?",
          "bind": {
            "custom": "IntakeAwareDate",
            "label": "Date Received or Discovered"
          },
          "required": true,
          "description": "GDPR: one month to respond. CCPA: 45 days."
        },
        {
          "key": "reference",
          "type": "text",
          "label": "Ticket number",
          "bind": {
            "custom": "IntakeReferenceId",
            "label": "External Reference ID"
          },
          "required": true
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Why is it escalated?",
          "bind": {
            "custom": "RequestDescription"
          },
          "required": true,
          "description": "Say whether identity is verified, who the person is (customer, employee, prospect), and what makes it unusual."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that controls the data."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The privacy operations owner of the ticket."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "The request and correspondence"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
