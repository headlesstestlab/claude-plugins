{
  "id": "msa-request",
  "name": "MSA Request",
  "description": "A master services agreement, buying or selling: the framework that later order forms and SOWs sit under.",
  "pages": [
    {
      "title": "MSA Request",
      "fields": [
        {
          "key": "party",
          "bind": {
            "provision": "Party"
          },
          "label": "Counterparty",
          "required": true,
          "description": "The legal name of the other company, as registered."
        },
        {
          "key": "side",
          "type": "dropdown",
          "label": "Is Fontara buying or selling?",
          "bind": {
            "custom": "DeskDealSide",
            "label": "Buying or Selling",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Buying: Fontara is the customer",
            "Selling: Fontara is the supplier",
            "Neither or mutual"
          ],
          "required": true,
          "description": "Decides whose template applies and who signs: the Head of Procurement (Victoria Lee) when buying, the VP of Sales (Corey Ikso) when selling, the CFO (Marcus Chen) over $1,000,000. Legal Operations (Maya Patel) reviews; non-standard terms go to the General Counsel (Elena Rodriguez)."
        },
        {
          "key": "crm_id",
          "type": "text",
          "label": "Salesforce opportunity ID",
          "bind": {
            "custom": "IntakeCrmId",
            "label": "CRM Opportunity ID"
          },
          "description": "From the opportunity URL: 15 or 18 characters starting 006."
        },
        {
          "key": "cost_center",
          "type": "text",
          "label": "Cost center",
          "bind": {
            "custom": "IntakeCostCenter",
            "label": "Cost Center"
          },
          "required": false,
          "description": "The cost center that pays, e.g. 4100-Marketing."
        },
        {
          "key": "approver",
          "type": "text",
          "label": "Approver",
          "bind": {
            "custom": "IntakeApprover",
            "label": "Budget Approver"
          },
          "description": "Buying: the Head of Procurement (Victoria Lee) up to $1,000,000. Selling: the VP of Sales (Corey Ikso) up to $1,000,000. Over $1,000,000: the CFO (Marcus Chen), with the VP of Sales."
        },
        {
          "key": "entity",
          "type": "dropdown",
          "label": "Fontara contracting entity",
          "bind": {
            "custom": "DeskFontaraEntity",
            "label": "Contracting Entity",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara, Inc.",
            "Fontara UK Ltd",
            "Fontara Europe Ltd"
          ],
          "required": true,
          "description": "The Fontara company that signs. US business: Fontara, Inc. UK: Fontara UK Ltd. EU: Fontara Europe Ltd."
        },
        {
          "key": "country",
          "type": "dropdown",
          "label": "Counterparty country",
          "bind": {
            "custom": "DeskCountry",
            "label": "Country of Counterparty",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "United States",
            "United Kingdom",
            "Australia",
            "Austria",
            "Belgium",
            "Brazil",
            "Bulgaria",
            "Canada",
            "China",
            "Croatia",
            "Cyprus",
            "Czechia",
            "Denmark",
            "Estonia",
            "Finland",
            "France",
            "Germany",
            "Greece",
            "Hungary",
            "India",
            "Ireland",
            "Israel",
            "Italy",
            "Japan",
            "Latvia",
            "Lithuania",
            "Luxembourg",
            "Malta",
            "Mexico",
            "Netherlands",
            "New Zealand",
            "Norway",
            "Poland",
            "Portugal",
            "Romania",
            "Singapore",
            "Slovakia",
            "Slovenia",
            "South Africa",
            "South Korea",
            "Spain",
            "Sweden",
            "Switzerland",
            "United Arab Emirates",
            "Other"
          ],
          "required": true,
          "description": "Where the other party is established. It drives governing law, data-transfer and tax review."
        },
        {
          "key": "paper",
          "type": "dropdown",
          "label": "Whose paper?",
          "bind": {
            "custom": "DeskPaperSource",
            "label": "Whose Paper",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Fontara's paper",
            "Counterparty's paper"
          ],
          "required": true,
          "description": "Our template means Fontara's standard on file. Counterparty's paper means their draft, which Legal reviews in full."
        },
        {
          "key": "their_draft",
          "type": "file",
          "label": "Counterparty's draft",
          "required": true,
          "description": "Their latest version, in Word if you have it."
        },
        {
          "key": "value",
          "bind": {
            "provision": "ContractValue"
          },
          "label": "Total contract value (TCV)",
          "required": false,
          "description": "Expected value across all orders, all years, excluding tax. An estimate is fine."
        },
        {
          "key": "payment_terms",
          "bind": {
            "provision": "PaymentTerms"
          },
          "label": "Payment terms"
        },
        {
          "key": "governing_law",
          "bind": {
            "provision": "GoverningLaw"
          },
          "label": "Governing law",
          "description": "Leave blank to use Fontara's standard for the entity."
        },
        {
          "key": "effective",
          "bind": {
            "provision": "EffectiveDate"
          },
          "label": "Effective date"
        },
        {
          "key": "renewal_type",
          "bind": {
            "provision": "RenewalType"
          },
          "label": "Renewal type"
        },
        {
          "key": "non_standard",
          "type": "dropdown",
          "label": "Are non-standard terms requested?",
          "bind": {
            "custom": "DeskNonStandard",
            "label": "Non-standard Terms",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "key": "liability",
          "bind": {
            "provision": "LiabilityCap"
          },
          "label": "Requested liability cap",
          "description": "Only if the other side wants a cap different from our standard (12 months' fees)."
        },
        {
          "key": "personal_data",
          "type": "dropdown",
          "label": "Will the other party access or receive personal data?",
          "bind": {
            "custom": "DeskPersonalData",
            "label": "Personal Data Involved",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No",
            "Not sure"
          ],
          "required": true,
          "description": "Customer, employee or prospect data. If Yes, say whether an existing DPA covers it: only new processing goes to the Data Protection Officer (Alexandra Kim)."
        },
        {
          "key": "existing_dpa",
          "type": "dropdown",
          "label": "Is this covered by an existing DPA?",
          "options": [
            "Yes",
            "No"
          ],
          "bind": {
            "custom": "DeskExistingDpa",
            "label": "Existing DPA Covers It",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "description": "No, or new data categories, new sub-processors or a new cross-border transfer: the Data Protection Officer (Alexandra Kim) reviews it. Yes, with nothing new: no privacy review."
        },
        {
          "key": "data_details",
          "type": "longtext",
          "label": "What personal data, about whom, and where will it be stored?",
          "bind": {
            "custom": "IntakeDataDetails",
            "label": "Personal Data Description"
          },
          "description": "For example: customer contact names and emails, stored in the vendor's EU data centre."
        },
        {
          "key": "data_class",
          "type": "dropdown",
          "label": "Data classification",
          "bind": {
            "custom": "DeskDataClass",
            "label": "Data Class",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Public",
            "Internal",
            "Confidential",
            "Restricted (special-category, children's or financial data)"
          ],
          "description": "The highest class of Fontara data involved. Restricted data needs Security/IT's vendor risk review before signature."
        },
        {
          "key": "privacy_note",
          "type": "description",
          "text": "The Data Protection Officer (Alexandra Kim) will follow up to confirm whether personal data is involved. If it is, and no existing DPA covers it, a DPA is needed before signature."
        },
        {
          "key": "signer",
          "type": "text",
          "label": "Counterparty signer",
          "bind": {
            "custom": "CounterpartySigner"
          },
          "description": "Name and title of the person who signs for them."
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Business owner",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Other attachments (SOW, quote)"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "side",
          "is": "Selling: Fontara is the supplier"
        }
      ],
      "then": {
        "crm_id": "show"
      }
    },
    {
      "when": [
        {
          "field": "side",
          "is": "Buying: Fontara is the customer"
        }
      ],
      "then": {
        "cost_center": "show",
        "approver": "show"
      }
    },
    {
      "when": [
        {
          "field": "paper",
          "is": "Counterparty's paper"
        }
      ],
      "then": {
        "their_draft": "show"
      }
    },
    {
      "when": [
        {
          "field": "non_standard",
          "is": "Yes"
        }
      ],
      "then": {
        "liability": "show"
      }
    },
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Yes"
        }
      ],
      "then": {
        "data_details": "show",
        "data_class": "show",
        "existing_dpa": "show"
      }
    },
    {
      "when": [
        {
          "field": "personal_data",
          "is": "Not sure"
        }
      ],
      "then": {
        "privacy_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
