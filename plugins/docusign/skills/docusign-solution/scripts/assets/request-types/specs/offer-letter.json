{
  "id": "offer-letter",
  "name": "Offer Exception Review",
  "description": "Legal review of an offer outside the approved band or standard terms. Standard offers are generated in the ATS and do not need Legal.",
  "pages": [
    {
      "title": "Offer Exception Review",
      "fields": [
        {
          "key": "employee_name",
          "bind": {
            "provision": "Party"
          },
          "label": "Candidate's full name",
          "required": true,
          "description": "The person, as a party to the agreement."
        },
        {
          "key": "req_id",
          "type": "text",
          "label": "Requisition ID",
          "bind": {
            "custom": "IntakeReferenceId",
            "label": "External Reference ID"
          },
          "required": true,
          "description": "From the ATS, e.g. REQ-2041."
        },
        {
          "key": "job_title",
          "type": "text",
          "label": "Job title",
          "bind": {
            "custom": "IntakeJobTitle",
            "label": "Job Title"
          },
          "required": true
        },
        {
          "key": "department",
          "type": "dropdown",
          "label": "Department",
          "bind": {
            "custom": "DeskDepartment",
            "label": "Department",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Sales",
            "Partnerships",
            "Corporate development",
            "Procurement",
            "Product",
            "Engineering",
            "Marketing",
            "Human Resources",
            "Legal",
            "Finance",
            "IT",
            "Operations",
            "Other"
          ],
          "required": true
        },
        {
          "key": "employment_type",
          "bind": {
            "provision": "EmploymentType"
          },
          "label": "Employment type",
          "required": true
        },
        {
          "key": "location",
          "bind": {
            "provision": "EmploymentLocation"
          },
          "label": "Work location (city and country)",
          "required": true,
          "description": "Country decides which employment contract and notice rules apply."
        },
        {
          "key": "hire_date",
          "bind": {
            "provision": "HireDate"
          },
          "label": "Proposed start date",
          "required": true
        },
        {
          "key": "compensation",
          "type": "text",
          "label": "Base compensation (annual)",
          "bind": {
            "custom": "IntakeCompensation",
            "label": "Base Compensation"
          },
          "required": true,
          "description": "Annual base salary with its currency, e.g. USD 120,000. For a non-US hire, the local-currency figure."
        },
        {
          "key": "non_standard",
          "type": "dropdown",
          "label": "Is anything outside the approved band or standard terms?",
          "bind": {
            "custom": "DeskNonStandard",
            "label": "Non-standard Terms",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "key": "standard_note",
          "type": "description",
          "text": "Standard offers are generated in the ATS. You do not need Legal: cancel this request and use the ATS offer template."
        },
        {
          "key": "exceptions",
          "type": "checkbox",
          "label": "What is outside the standard offer?",
          "options": [
            "Base salary above band",
            "Sign-on bonus",
            "Guaranteed bonus",
            "Equity grant",
            "Relocation",
            "Visa sponsorship",
            "Notice period or non-compete",
            "Other"
          ]
        },
        {
          "key": "details",
          "type": "longtext",
          "label": "Describe the exception and the business case",
          "bind": {
            "custom": "RequestDescription"
          }
        },
        {
          "key": "owner",
          "type": "text",
          "label": "Hiring manager",
          "bind": {
            "custom": "BusinessOwnerName"
          },
          "required": true,
          "description": "The person accountable for this agreement after it is signed."
        },
        {
          "key": "urgency",
          "type": "dropdown",
          "label": "Urgency",
          "bind": {
            "custom": "DeskUrgency",
            "label": "Urgency",
            "type": "Dropdown",
            "accountWideOptions": true
          },
          "options": [
            "Standard (5 business days)",
            "Expedited (2 business days)",
            "Urgent (24 hours, VP approval)"
          ],
          "required": true,
          "description": "Standard is five business days. Urgent needs a VP's approval: name them in the reason. Urgency changes how fast Legal Operations (Maya Patel) works the request, not who approves the deal, which follows Fontara's escalation matrix."
        },
        {
          "key": "urgency_reason",
          "type": "longtext",
          "label": "Why is this urgent?",
          "bind": {
            "custom": "IntakeUrgencyReason",
            "label": "Urgency Reason"
          },
          "description": "The business deadline or risk, and the VP who approved the urgency."
        },
        {
          "key": "needed_by",
          "type": "date",
          "label": "Offer needed by",
          "bind": {
            "custom": "TargetDueDate"
          },
          "description": "When you need Legal's work finished. Not the contract's start or end date."
        },
        {
          "key": "documents",
          "type": "file",
          "label": "Compensation approval"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "field": "non_standard",
          "is": "Yes"
        }
      ],
      "then": {
        "exceptions": "show",
        "details": "show"
      }
    },
    {
      "when": [
        {
          "field": "non_standard",
          "is": "No"
        }
      ],
      "then": {
        "standard_note": "show"
      }
    },
    {
      "when": [
        {
          "field": "urgency",
          "is": "Urgent (24 hours, VP approval)"
        }
      ],
      "then": {
        "urgency_reason": "show"
      }
    }
  ]
}
