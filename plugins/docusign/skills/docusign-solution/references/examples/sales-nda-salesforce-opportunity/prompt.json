{
  "id": "sales-nda-salesforce-opportunity",
  "prompt": "Our reps should be able to send an NDA straight from a Salesforce opportunity. Pull the account name, billing address and the primary contact, and the rep signs on our side after the customer. When it's signed, attach the signed PDF to the opportunity and set its NDA Status field to Signed.",
  "industry": "software",
  "department": "sales",
  "variation_tags": {
    "start": [
      "salesforce-launcher"
    ],
    "routing": [
      "serial"
    ],
    "approvals": [
      "none"
    ],
    "data_source": [
      "salesforce"
    ],
    "locale": [
      "en-US"
    ],
    "currency": [
      "USD"
    ],
    "platform": "iam",
    "ai": [
      "none"
    ],
    "documents": [
      "generated"
    ],
    "logic": [
      "none"
    ],
    "notifications": [
      "email"
    ],
    "identity": [
      "none"
    ],
    "payment": false,
    "agreement_desk": false
  },
  "expected_assets": [
    {
      "kind": "doc-template",
      "purpose": "NDA with Salesforce merge fields",
      "features": [
        "Account.Name and billing address from the Opportunity",
        "contact from OpportunityContactRole",
        "signer fields for Customer and Company roles"
      ]
    },
    {
      "kind": "workflow",
      "purpose": "launcher-started generate and send",
      "features": [
        "From a Link start with recordId/objectName/applicationName/orgId",
        "generate with recordId = start.recordId",
        "send: contact then the rep (starter)",
        "Store Files in Salesforce on the Opportunity",
        "Writeback: NDA_Status__c = Signed"
      ]
    }
  ],
  "acceptance": [
    "the start exposes exactly the four launcher variables recordId, objectName, applicationName, orgId",
    "the template's recordId is mapped from start.recordId; no step asks a person for a Salesforce id",
    "the primary contact is read through OpportunityContactRole, not Opportunity.Contact",
    "signing order: customer contact 1, the rep 2",
    "after completion the signed PDF is a file on the launching Opportunity",
    "NDA_Status__c is updated only after the envelope completes"
  ],
  "hard_parts": [
    "an Opportunity has no direct Contact relationship; the contact must come from OpportunityContactRole",
    "the published workflow appears in the launcher only on the account the Salesforce org is connected to"
  ],
  "clarifying_questions": [
    {
      "question": "Which contact signs: the primary contact role, or one the rep picks?",
      "default": "the primary OpportunityContactRole"
    },
    {
      "question": "Does the rep sign, or a fixed signatory?",
      "default": "the rep who launched it (the starter)"
    }
  ],
