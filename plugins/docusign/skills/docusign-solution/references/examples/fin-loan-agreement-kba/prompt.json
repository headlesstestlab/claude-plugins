  "expected_assets": [
    {
      "kind": "doc-template",
      "purpose": "loan agreement",
      "features": [
        "principal (currency), APR (number), term months, payment schedule"
      ]
    },
    {
      "kind": "workflow",
      "purpose": "API start",
      "features": [
        "variables incl. co-borrower optional",
        "send borrower(s) with KBA → officer"
      ]
    }
  ],
  "acceptance": [
    "each borrower authenticates with KBA before signing",
    "no co-borrower role when none is passed",
    "APR prints with 2 decimals (the loan system sends it as text, e.g. \"7.50\"; the README's integration notes say so)"
  ],
  "hard_parts": [
    "KBA is US-only and set on the recipient; a workflow send must carry it [inferred]",
    "an optional signer from an API variable may need two send shapes"
  ],
  "clarifying_questions": [
    {
      "question": "Max co-borrowers?",
      "default": "one"
    }
  ],
