{
  "id": "fin-loan-agreement-kba",
  "prompt": "Small business loans: the loan officer starts a loan agreement from our system with the borrower, amount, rate and term. Borrower and any co-borrowers sign with knowledge-based authentication; the bank officer countersigns.",
  "industry": "banking",
  "department": "lending",
  "variation_tags": {
