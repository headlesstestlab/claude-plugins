{
  "id": "sales-mutual-nda-web-form",
  "prompt": "We want prospects to request our standard mutual NDA from a page on our website. They fill in their company name, address and signer, the NDA is generated and they sign first, then our general counsel countersigns.",
  "industry": "software",
  "department": "sales",
  "variation_tags": {
