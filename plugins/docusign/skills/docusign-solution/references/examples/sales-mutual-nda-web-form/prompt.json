    ],
    "payment": false,
    "agreement_desk": false
  },
  "expected_assets": [
    {
      "kind": "webform",
      "purpose": "public intake for the counterparty",
      "features": [
        "company name, address, signer name and email",
        "required fields",
        "no login"
      ]
    },
    {
      "kind": "doc-template",
      "purpose": "mutual NDA generated from the form answers",
      "features": [
        "party name and address fields",
        "effective date",
        "signature and date-signed for two roles"
      ]
    },
    {
      "kind": "workflow",
      "purpose": "intake → generate → serial signing",
      "features": [
        "web-form start",
        "Prepare Document Template filled from the form",
        "one send: counterparty then general counsel"
      ]
    }
  ],
  "acceptance": [
    "the workflow starts from the web form, not from a Salesforce record",
    "every document-template field is filled from a form field or a fixed value; none is left for the sender",
    "the envelope has two signers in order: the form submitter (1), general counsel (2)",
    "general counsel is a fixed account user or role, not typed by the submitter"
  ],
  "hard_parts": [
    "a public form means the starter is anonymous: the counterparty must be the first signer and the envelope sender must be set explicitly",
    "the product runs a bot check on live web forms, so an end-to-end run needs a real browser"
  ],
  "clarifying_questions": [
    {
      "question": "Who countersigns for you, and do you want them notified by email when the counterparty has signed?",
      "default": "general counsel as a fixed user; Docusign completion email only"
    },
    {
      "question": "Should the NDA term be fixed or chosen on the form?",
      "default": "fixed: 2 years, confidentiality survives 3 years"
    }
  ],
