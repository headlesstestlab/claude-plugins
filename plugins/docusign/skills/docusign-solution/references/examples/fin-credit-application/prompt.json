      "purpose": "credit application and personal guarantee",
      "features": [
        "guarantee section conditional"
      ]
    },
    {
      "kind": "workflow",
      "purpose": "apply → approve → sign",
      "features": [
        "branch limit > 50,000",
        "send applicant (+ guarantor)",
        "credit approval"
      ]
    }
  ],
  "acceptance": [
    "a $60,000 request adds the guarantor signer; $40,000 does not",
    "the EIN field validates 9 digits",
    "the credit team approval is recorded with its outcome"
  ],
  "hard_parts": [
    "web form numeric validation has no ranges per the builder, so the 50,000 threshold is a branch, not a form rule"
  ],
  "clarifying_questions": [
    {
      "question": "Does credit approve before or after signing?",
